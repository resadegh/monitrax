# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/monitrax?schema=public"

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT Secret (generate a strong random string for production)
# Generate with: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-this-in-production"

# NextAuth (if using NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-this-in-production"

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================
# Configure at least one provider to enable social login
# See docs/OAUTH-SETUP.md for detailed setup instructions

# Google OAuth 2.0
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Facebook Login
# Get credentials at: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/callback/facebook"

# Apple Sign In
# Get credentials at: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""  # Generated JWT from private key
APPLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/apple"

# Microsoft OAuth 2.0
# Get credentials at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/callback/microsoft"

# =============================================================================
# GCP IDENTITY PLATFORM
# =============================================================================
# Required for GCP Identity Platform / Firebase Auth migration
# Get your project ID from: https://console.cloud.google.com/identity
GCP_PROJECT_ID=""

# Client-side Firebase SDK config (required for GCP Identity login)
# Get the API key from: GCP Console → APIs & Services → Credentials → API Keys
NEXT_PUBLIC_GCP_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_API_KEY=""

# =============================================================================
# BASIQ OPEN BANKING
# =============================================================================
# Basiq API for Australian Open Banking integration
# Get credentials at: https://dashboard.basiq.io
# Documentation: https://api.basiq.io/reference

# Your Basiq API key (required for bank connections)
BASIQ_API_KEY=""

# Basiq API URL (defaults to Australian endpoint if not set)
BASIQ_API_URL="https://au-api.basiq.io"

# =============================================================================
# ENVIRONMENT
# =============================================================================
NODE_ENV="development"

# Production URLs (update for production deployment)
# GOOGLE_REDIRECT_URI="https://yourdomain.com/api/auth/callback/google"
# FACEBOOK_REDIRECT_URI="https://yourdomain.com/api/auth/callback/facebook"
# APPLE_REDIRECT_URI="https://yourdomain.com/api/auth/callback/apple"
# MICROSOFT_REDIRECT_URI="https://yourdomain.com/api/auth/callback/microsoft"
