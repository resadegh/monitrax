  organizationId String @unique

  // Organization Type & Plan
  organizationType OrganizationType @default(ACCOUNTING_FIRM)
  plan             OrganizationPlan @default(STARTER)

  // Portal Features
  portalEnabled Boolean @default(false)
  maxClients    Int     @default(10)
  maxStaff      Int     @default(3)

  // White-labeling
  brandName           String?
  brandLogoUrl        String?
  brandPrimaryColor   String? // Hex color
  brandSecondaryColor String?
  customDomain        String? // Future: custom domain support

  // Contact Info
  businessEmail   String?
  businessPhone   String?
  businessAddress String?
  abn             String? // Australian Business Number
  acn             String? // Australian Company Number

  // Compliance
  afslNumber     String? // AFSL license number
  taxAgentNumber String? // Tax agent registration

  // SSO/SAML (Phase 32.12)
  ssoEnabled      Boolean @default(false)
  samlEntityId    String?
  samlSsoUrl      String?
  samlCertificate String? @db.Text

  // Billing
  billingEmail       String?
  stripeCustomerId   String?
  subscriptionStatus String? @default("trialing")

  // Timestamps
