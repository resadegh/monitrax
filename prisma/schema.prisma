// =============================================================================
// PHASE 32: ENTERPRISE PORTAL - ENUMS
// =============================================================================

enum OrganizationType {
  ACCOUNTING_FIRM
  FINANCIAL_ADVISOR
  MORTGAGE_BROKER
  TAX_AGENT
  BOOKKEEPER
  OTHER
}

enum OrganizationPlan {
  STARTER // Up to 10 clients
  PROFESSIONAL // Up to 50 clients
  BUSINESS // Up to 200 clients
  ENTERPRISE // Unlimited clients
}

enum PortalUserRole {
  PORTAL_OWNER // Full organization control
  PORTAL_ADMIN // Manage staff and clients
  PORTAL_ADVISOR // Access assigned clients
  PORTAL_VIEWER // Read-only access
}

enum ClientStatus {
  INVITED // Invitation sent, not accepted
  PENDING // Accepted, awaiting consent
  ACTIVE // Full access granted
  SUSPENDED // Temporarily disabled
  ARCHIVED // Soft deleted
}

enum DataAccessScope {
  FULL // All data
  FINANCIAL // Accounts, transactions
  INVESTMENTS // Investment accounts, holdings
  TAX // Tax-related data
  DOCUMENTS // Document access
  TRANSACTIONS // Transaction history
  PROPERTIES // Property data
  LOANS // Loan data
}

enum ConsentStatus {
  PENDING // Waiting for client response
  GRANTED // Client approved access
  REVOKED // Client withdrew consent
  EXPIRED // Consent period ended
}

enum InvitationType {
  STAFF // Inviting staff member
  CLIENT // Inviting client
}

enum InvitationStatus {
  PENDING // Awaiting response
  ACCEPTED // Invitation accepted
  DECLINED // Invitation declined
  EXPIRED // Invitation expired
  CANCELLED // Cancelled by org
}

enum ClientTaskStatus {
  TODO // Not started
  IN_PROGRESS // Work in progress
  WAITING // Waiting on client/external
  COMPLETED // Done
  CANCELLED // Cancelled
}

enum ClientTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Phase 32B PR3 #9a — alert-engine lifecycle. ACTIVE while the
// triggering condition still holds; auto-RESOLVED by the sweep when
// the condition clears; DISMISSED when an adviser explicitly clears it
// (sticky — does not re-fire while the condition persists).
enum ClientAlertStatus {
  ACTIVE
  DISMISSED
  RESOLVED
}

enum ApiKeyScope {
  READ_CLIENTS // List and view clients
  READ_FINANCIAL // Read financial data
  READ_DOCUMENTS // Access documents
  SYNC_ACCOUNTING // Sync with accounting software
  FULL_ACCESS // All permissions
}

enum AccountingProvider {
  XERO // Primary integration
  MYOB // Future
  QUICKBOOKS // Future
  SAGE // Future
  FRESHBOOKS // Future
  WAVE // Future
  OTHER // Generic
}

// Phase 41f: scope discriminator for AccountingIntegration. ORG = the
// Phase 32 portal use case (an adviser org connecting their own books).
// USER_ENTITY = the Phase 41f use case (a consumer user connecting their
// personal entity's books — Pty Ltd / Sole Trader / Trust trustee /
// SMSF). XOR-enforced via a Postgres CHECK constraint in the matching
// migration: exactly one of (organizationId) or (userId + legalEntityId)
// is set per row.
enum AccountingIntegrationScope {
  ORG
  USER_ENTITY
}

// Phase 41f: lifecycle for trust-deed extracted rules. The 4-step
// confirm-before-apply flow per PHASE_41F_BOOKKEEPING_INTEGRATION.md
// §7 ensures no tax engine consumes AI-extracted legal-instrument
// interpretation until the user has explicitly confirmed each rule.
enum TrustDeedRuleStatus {
  EXTRACTED // AI extracted, awaiting user review
  CONFIRMED // User reviewed + confirmed; tax engines may consume
  REJECTED // User rejected the extraction; will not feed any tax engine
}

enum IntegrationSyncDirection {
  OUTBOUND // Monitrax → External (default)
  INBOUND // External → Monitrax (reference only)
  BIDIRECTIONAL // Both ways (future)
}

enum IntegrationSyncStatus {
  PENDING // Queued for sync
  IN_PROGRESS // Currently syncing
  COMPLETED // Sync successful
  FAILED // Sync failed
  PARTIAL // Some items failed
}

