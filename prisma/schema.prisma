// Monitrax Database Schema
// This is the single source of truth for all financial data
//
// Generator + datasource notes:
//   - `previewFeatures = ["driverAdapters"]` is required so `lib/db.ts` can
//     supply a `pg`-backed adapter (Prisma 5 driver adapters). The standard
//     `DATABASE_URL` branch still works — the preview feature is a no-op
//     until a `PrismaClient({ adapter })` is constructed.
//   - `DATABASE_URL` is only used by the standard branch and by
//     `prisma migrate deploy` at build time. When `USE_CLOUD_SQL_CONNECTOR=true`
//     the runtime ignores it and authenticates via Workload Identity
//     Federation instead. See `lib/db.ts` and
//     `docs/operational/security/04_WIF_TROUBLESHOOTING.md`.

generator client {
  provider        = "prisma-client-js"
  // omitApi: query-level `omit` argument (e.g. `{ omit: { heroImage: true } }`).
  // Added 2026-06-09 (Phase 45.2.5) so /api/properties[*] can skip loading the
  // multi-MB hero photo bytea on every fetch — the bytes live on a dedicated
  // hero-image endpoint instead. Promoted to GA in Prisma 5.16; we pin the
  // preview feature here for explicit signalling until we upgrade to a Prisma
  // version that surfaces `omit` without it.
  previewFeatures = ["driverAdapters", "omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

