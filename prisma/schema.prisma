}

// =============================================================================
// PHASE 10: LOGIN ATTEMPTS (for account lockout)
// =============================================================================

model LoginAttempt {
  id          String   @id @default(uuid())
  userId      String
  email       String
  success     Boolean
  ipAddress   String?
  userAgent   String?
  attemptedAt DateTime @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([attemptedAt])
  @@map("login_attempts")
