// =============================================================================
// PHASE 41: LEGAL ENTITY (Entity Layer foundation)
// =============================================================================

// `LegalEntityType` — the structural form a wealth-holding vehicle takes.
// Forced at registration via the onboarding wizard (Phase 41b). The full
// taxonomy is intentionally narrow at v1; uncommon shapes (foreign trusts,
// bare trusts, etc.) escalate to OTHER-style support requests until demand
// proves out. See `docs/architecture/03_DATA_MODEL.md` §10.
enum LegalEntityType {
  // Phase 41 original values — order preserved (DB enum order must match).
  PERSONAL_NAME // Default — assets held in a natural person's own name
  COMPANY // Pty Ltd / Ltd — see CompanySubtype
  DISCRETIONARY_TRUST // Family discretionary trust (most common AU structure)
  UNIT_TRUST // Fixed-unit trust
  SMSF // Self-Managed Super Fund (regulated by ATO)
  PARTNERSHIP // General or limited partnership
  SOLE_TRADER // ABN-registered individual operating a business
  // Phase 44 additions — appended to match the migration's ADD VALUE order.
  INDIVIDUAL // a natural person as a legal actor (director / shareholder / beneficiary / trustee / member); not all are Monitrax users
  FIXED_TRUST // a fixed (non-unit) trust
  HYBRID_TRUST // a hybrid trust (discretionary + unit features)
  BARE_TRUST // a holding trust; incl. the SMSF LRBA holding trust
  TESTAMENTARY_TRUST // a trust created by a will (minor-beneficiary excepted-income concession)
  DECEASED_ESTATE // estate administered by an executor/administrator before distribution
  FOREIGN_COMPANY // a company incorporated outside Australia
  INCORPORATED_ASSOCIATION // a state-registered incorporated association
  CO_OPERATIVE // a registered co-operative
  STRATA_BODY_CORPORATE // an owners corporation / body corporate
  CUSTODIAN_PLATFORM // a custodian / wrap-platform vehicle holding investments as bare custodian
  OTHER // outside the supported grammar; recorded + flagged unsupportedStructure
}

// `LegalEntityRole` — the *purpose* of the entity in the user's wealth picture.
// One person + multiple entities is normal: PERSONAL (natural name) +
// HOLDING (family trust holds investments) + OPERATING (Pty Ltd runs a
// business) + SUPERANNUATION (SMSF). Drives Phase 41c entity-tree colour and
// Phase 41h AI advisor framing.
enum LegalEntityRole {
  HOLDING // Holds passive investments (most common for trusts)
  OPERATING // Runs an active business (most common for Pty Ltd / sole traders)
  INVESTMENT // Investment-only vehicle (e.g. unit trust used as a property syndicate)
  SUPERANNUATION // SMSF — superannuation only
  PERSONAL // Natural person ownership (default for every existing user)
  CORPORATE_TRUSTEE // Phase 44 — a company whose function is purely to be a trustee
}

// Phase 41E reform 2026-27 — Measure 3 dispatch input.
// Only `DISCRETIONARY` trusts are subject to the 30% minimum tax on trust
// taxable income from FY 2028-29 onwards. Fixed/unit/widely-held/complying-super/
// charitable/deceased-estate/special-disability/fixed-testamentary trusts are
// explicitly excluded per Treasury fact sheet. See
// `docs/blueprint/PHASE_41E_REFORM_2026_27.md` §4.2 + §10.3.
//
// Backfill: every existing `LegalEntity.type === 'DISCRETIONARY_TRUST'` gets
// `trustType := 'DISCRETIONARY'` (unambiguous — Phase 41a's LegalEntityType
// already names it explicitly). Other trust subtypes need user confirmation
// in the entity-detail UI; until set, engine treats as `OTHER` + surfaces
// `UC-TRUST-TYPE-UNKNOWN`.
enum TrustType {
  DISCRETIONARY // Family discretionary trust — subject to Measure 3
  FIXED // Fixed trust — excluded
  UNIT // Unit trust — excluded
  TESTAMENTARY_FIXED // Fixed testamentary trust — excluded
  CHARITABLE // Charitable trust — excluded
  DECEASED_ESTATE // Deceased estate — excluded
  SPECIAL_DISABILITY // Special disability trust — excluded
  OTHER // Catch-all; UC-TRUST-TYPE-UNKNOWN until user confirms
  // Phase 44 additions — appended to match the migration's ADD VALUE order.
  HYBRID // hybrid trust (discretionary + unit features)
  TESTAMENTARY // testamentary trust (discretionary); minor-beneficiary excepted income
}

// `LegalEntity` — the foundational ownership object for the Phase 41 entity
// layer. Every Property / Loan / Account / InvestmentAccount / Asset / Income /
// Expense will hang off a `LegalEntity` via `ownerEntityId` (instead of the
// flat `userId` it lives on today). The migration backfills every existing
// user with a single `PERSONAL_NAME` entity and reassigns existing rows to
// it, so behaviour is preserved end-to-end before the wizard ships.
//
// TFN handling (CLAUDE.md §13):
//   - `tfnEncrypted` is OPTIONAL. Default-off — the user must explicitly
//     opt in via the wizard.
//   - At rest the field is base64-wrapped via `lib/security/tfnEncryption.ts`
//     (mirrors the `MFAMethod.secret` pattern). The helper is a single
//     swap-point for upgrading to KMS-backed CMEK encryption when CMEK lands
//     (queued in `IMPLEMENTATION_PLAN.md` Up Next #3).
//   - TFN MUST never be logged, MUST never appear in audit metadata (use
//     `sanitizeCdrMetadata()` if a tfn-bearing entity flows through audit
//     logging by accident), MUST never be sent to Gemini / any AI model.
//   - Read paths use `getTfnForUser(...)` which decrypts inside a single
//     authorisation boundary; the field is never returned via API
//     responses by default.
model LegalEntity {
  id              String          @id @default(uuid())
  userId          String
  name            String // Display name — "Smith Family Trust" / "Reza Sadeghi" / "Acme Pty Ltd"
  type            LegalEntityType
  role            LegalEntityRole
  abn             String? // 11-digit Australian Business Number (companies, trusts, partnerships, sole traders)
  acn             String? // 9-digit Australian Company Number (companies only)
  tfnEncrypted    String? // Encrypted at rest via lib/security/tfnEncryption.ts; never logged, never sent to AI
  tradingName     String? // Optional trading-as name distinct from legal name
  establishedDate DateTime? // Date the entity was formed (incorporation / trust deed execution / SMSF establishment)
  parentEntityId  String? // Self-FK for trustee → trust relationships (e.g. corporate trustee Pty Ltd is parent of the Family Trust)

  // Phase 41E reform 2026-27 inputs (CLAUDE.md §12.14). Nullable + additive.
  // `trustType` drives Measure 3 dispatch (only DISCRETIONARY is affected).
  // `isForeignResident` drives Measure 4 (Div 855 TARP + 365-day PAT).
  // See `docs/blueprint/PHASE_41E_REFORM_2026_27.md` §4.2 + §10.3 + §10.4.
  trustType         TrustType? // Set only when `type === DISCRETIONARY_TRUST | UNIT_TRUST | ...`
  isForeignResident Boolean? // Drives Measure 4 dispatch; null = treated as resident (UC-FR-STATUS-UNKNOWN if entity has TARP-relevant assets). Phase 44: superseded by `taxResidencyStatus` — kept for the Phase 41E dispatch + back-compat.

  // Phase 44 — Entity Graph additive fields. Design: docs/blueprint/PHASE_44_ENTITY_GRAPH.md §7.
  companySubtype                        CompanySubtype? // COMPANY only — drives the §6 validity branch
  dateOfBirth                           DateTime? // INDIVIDUAL nodes only
  directorIdEncrypted                   String? // Director ID — sensitive; encrypted via lib/security/tfnEncryption.ts; never logged / AI / default API
  householdMemberId                     String? // optional link: this INDIVIDUAL is a known household member
  canHoldLegalTitle                     Boolean         @default(true) // false for Trust / Partnership — they are not legal persons (§3A)
  taxReportingEntity                    Boolean         @default(true) // lodges a tax return
  requiresTrusteeOrNomineeForLegalTitle Boolean         @default(false) // true for Trust / Partnership
  taxResidencyStatus                    String? // AUSTRALIAN_RESIDENT / FOREIGN_RESIDENT / TEMPORARY_RESIDENT / DUAL_RESIDENT / UNKNOWN
  centralManagementControlCountry       String?
  placeOfIncorporation                  String?
  governingJurisdiction                 String? // state-varying land tax / duty / association law — NSW / VIC / ... / FEDERAL / FOREIGN
  registrationJurisdiction              String?
  vestingDate                           DateTime? // trusts
  perpetuityPeriod                      String? // trusts
  deedDate                              DateTime? // trusts
  lastVariationDate                     DateTime? // trusts
  trustProperLawJurisdiction            String? // trusts
  estateAdministrationStatus            String? // DECEASED_ESTATE only — EARLY / PARTLY / FULLY_ADMINISTERED / FINAL_DISTRIBUTION_COMPLETE
  partnershipSubtype                    String? // Phase 47 F4 (F-LAW review) — PARTNERSHIP only: GENERAL / LIMITED / INCORPORATED_LIMITED / VCLP / ESVCLP. Corporate limited partnerships are taxed as companies (Div 5A ITAA36); VCLP/ESVCLP carry Phase 41E Measure 7 treatment.
  regulatoryStatus                      String[] // ACNC_REGISTERED_CHARITY / DGR / INCOME_TAX_EXEMPT / NFP / REGISTERED_FOREIGN_BODY / AFSL_HOLDER / RESPONSIBLE_ENTITY
  unsupportedStructure                  Boolean         @default(false) // true when type = OTHER
  structuralState                       StructuralState @default(VALID) // §6.1 three-state classification
  accountantVerified                    Boolean         @default(false) // §9 provenance flag

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentEntity  LegalEntity?  @relation("EntityHierarchy", fields: [parentEntityId], references: [id], onDelete: SetNull)
  childEntities LegalEntity[] @relation("EntityHierarchy")

  // Reverse owner relations (every owned object hangs back here)
  properties             Property[]
  loans                  Loan[]
  accounts               Account[]
  investmentAccounts     InvestmentAccount[]
  superannuationAccounts SuperannuationAccount[] // Phase 39.5: SMSF member accounts
  smsfAnnualReturns      SmsfAnnualReturn[] // Phase 44.2: SMSF fund-tax figures (when type=SMSF)
  assets                 Asset[]
  incomes                Income[]
  expenses               Expense[]

  // Phase 41f: bookkeeping integration (USER_ENTITY scope only — see
  // PHASE_41F_BOOKKEEPING_INTEGRATION.md). Cascades on entity delete.
  accountingIntegrations  AccountingIntegration[]
  accountingSnapshots     EntityAccountingSnapshot[]
  trustDeedExtractedRules TrustDeedExtractedRules[]

  // Phase 41E reform 2026-27 — Measure 5 (loss refundability — carry-back).
  // Companies with turnover < $1B can elect to carry back losses against
  // prior 2 years' tax paid. See PHASE_41E_REFORM_2026_27.md §10.5.
  companyTaxHistory CompanyTaxHistory[]

  // Phase 44 — Entity Graph reverse relations.
  relationshipsFrom EntityRelationship[] @relation("RelationshipsFrom")
  relationshipsTo   EntityRelationship[] @relation("RelationshipsTo")
  ownershipStakes   OwnershipStake[]

  @@index([userId])
  @@index([type])
  @@index([parentEntityId])
  @@index([trustType]) // Phase 41E — Measure 3 dispatch reads DISCRETIONARY trusts
  @@map("legal_entities")
}

// =============================================================================
// PHASE 44 — ENTITY GRAPH & STRUCTURE MODELLING (Part 1a — schema)
// Design contract: docs/blueprint/PHASE_44_ENTITY_GRAPH.md.
// The typed, directed, time-bounded relationship graph Phase 41 deferred.
// PURE DATA LAYER — all validity logic lives in lib/entity-graph/ (§8.4);
// all tax / financial computation stays in the existing engines (§8.3).
// Additive throughout — no destructive change to Phase 41.
// =============================================================================

// One enum for every relationship type — adding a type never needs a
// migration (§3). Directionality + legal meaning: PHASE_44 §5.
enum EntityRelationshipType {
  TRUSTEE_OF
  APPOINTOR_OF
  GUARDIAN_OF // guardian / protector
  POWER_HOLDER_OF // veto / consent / direction power
  SETTLOR_OF
  BENEFICIARY_OF
  EXECUTOR_OF // deceased estate (with a will)
  ADMINISTRATOR_OF // deceased estate (intestate)
  LEGAL_PERSONAL_REPRESENTATIVE_FOR // SMSF exception cases — death / incapacity / minor / EPOA
  UNITHOLDER_OF
  SHAREHOLDER_OF
  DIRECTOR_OF
  SECRETARY_OF
  PUBLIC_OFFICER_OF
  MEMBER_OF
  PARTNER_OF
  OPERATES_AS_SOLE_TRADER
  FAMILY_MEMBER_OF // Div 7A associate / SMSF related-party input
  ASSOCIATE_OF // accountant-confirmed association override
}

enum BeneficiaryClass {
  PRIMARY
  GENERAL
  DEFAULT
  NAMED
  RESIDUARY // deceased estate / testamentary
  SPECIFIC_GIFT // deceased estate / testamentary
  LIFE_TENANT // deceased estate / testamentary
  REMAINDERMAN // deceased estate / testamentary
}

// Three-state structural classification (PHASE_44 §6.1). Only
// IMPOSSIBLE_SYSTEM_ERROR is rejected at write time; legal non-compliance
// is recorded + flagged (never erased) so Monitrax stays a faithful twin.
enum StructuralState {
  VALID
  NON_COMPLIANT_BUT_RECORDED
  IMPOSSIBLE_SYSTEM_ERROR
}

enum ShareClass {
  ORDINARY
  PREFERENCE
  REDEEMABLE_PREFERENCE
  A_CLASS
  B_CLASS
  C_CLASS
  OTHER
}

enum EquityKind {
  SHARE // company shares
  UNIT // unit-trust units
}

enum TenancyType {
  SOLE
  JOINT_TENANTS // survivorship applies — interest does NOT pass through the deceased estate
  TENANTS_IN_COMMON // fixed fractional ownership
  OTHER
}

enum BeneficialOwnershipBasis {
  BARE_TRUST
  NOMINEE
  CUSTODIAN
  RESULTING_TRUST
  OTHER
}

enum CompanySubtype {
  PROPRIETARY // Pty Ltd — has shareholders
  PUBLIC // Ltd — has shareholders
  LIMITED_BY_GUARANTEE // has members, no share capital (typical NFP)
  UNLIMITED
  NO_LIABILITY // NL company (mining)
}

// `EntityRelationship` — one typed, directed, time-bounded edge in the
// entity graph. Equity detail is first-class in `ShareParcel`, never JSON.
model EntityRelationship {
  id           String                 @id @default(uuid())
  userId       String // tenancy scope — every edge belongs to one user's structure
  fromEntityId String
  toEntityId   String
  type         EntityRelationshipType

  // Time-bounding — a director resigns, shares are sold, a trust vests.
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // null = current

  // Edge-specific metadata (small, structured).
  beneficiaryClass     BeneficiaryClass? // BENEFICIARY_OF
  partnerInterestPct   Decimal?          @db.Decimal(9, 6) // PARTNER_OF — a change closes this edge + opens a new one
  partnerCapitalAmount Decimal?          @db.Decimal(19, 4) // PARTNER_OF
  familyRelation       String? // FAMILY_MEMBER_OF — SPOUSE / DE_FACTO / CHILD / PARENT / SIBLING / OTHER_RELATIVE
  lprReason            String? // LEGAL_PERSONAL_REPRESENTATIVE_FOR — DEATH / INCAPACITY / MINOR / EPOA / OTHER
  appointorPower       String[] // APPOINTOR_OF — CAN_REMOVE_TRUSTEE / CAN_APPOINT_TRUSTEE / ...
  powerType            String? // POWER_HOLDER_OF — VETO / CONSENT / DIRECTION / OTHER
  powerSubject         String? // POWER_HOLDER_OF — DISTRIBUTION / CAPITAL / TRUSTEE_CHANGE / DEED_AMENDMENT / ...
  tfnQuoted            Boolean? // BENEFICIARY_OF / SHAREHOLDER_OF / UNITHOLDER_OF — TFN-withholding fact; never the TFN itself
  sourceDocumentId     String?
  notes                String?

  // Three-state classification + provenance (§6.1, §9).
  structuralState    StructuralState @default(VALID)
  accountantVerified Boolean         @default(false)
  verifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromEntity   LegalEntity   @relation("RelationshipsFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity     LegalEntity   @relation("RelationshipsTo", fields: [toEntityId], references: [id], onDelete: Cascade)
  shareParcels ShareParcel[]

  @@index([userId])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([type])
  @@map("entity_relationships")
}

// `ShareParcel` — first-class equity detail (company shares AND unit-trust
// units). Hangs off a SHAREHOLDER_OF / UNITHOLDER_OF edge. Decimal
// throughout — CGT cost base depends on exact figures.
model ShareParcel {
  id             String     @id @default(uuid())
  relationshipId String
  kind           EquityKind
  shareClass     ShareClass @default(ORDINARY)
  quantity       Decimal    @db.Decimal(24, 8) // fractional units exist
  paidPerUnit    Decimal    @db.Decimal(19, 6) // CGT cost-base input
  unpaidPerUnit  Decimal    @default(0) @db.Decimal(19, 6) // partly-paid shares — calls outstanding
  acquiredAt     DateTime // CGT acquisition date
  disposedAt     DateTime? // null = still held

  relationship EntityRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([relationshipId])
  @@map("share_parcels")
}

// `OwnershipGroup` + `OwnershipStake` — joint / shared ownership of an
// owned object (PHASE_44 §7, Q1). Layered BESIDE `ownerEntityId` (which
// stays the primary / legal-title owner). Joint tenancy carries
// survivorship; tenants-in-common carry fixed fractions.
model OwnershipGroup {
  id              String      @id @default(uuid())
  userId          String
  ownedObjectType String // 'property' | 'loan' | 'account' | 'investmentAccount' | 'asset'
  ownedObjectId   String
  tenancyType     TenancyType
  effectiveFrom   DateTime    @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stakes OwnershipStake[]

  @@index([userId])
  @@index([ownedObjectType, ownedObjectId])
  @@map("ownership_groups")
}

model OwnershipStake {
  id                  String   @id @default(uuid())
  ownershipGroupId    String
  entityId            String
  sharePct            Decimal? @db.Decimal(9, 6) // required for TENANTS_IN_COMMON (sum 100); optional/reporting-only for JOINT_TENANTS
  survivorshipApplies Boolean  @default(false) // true for JOINT_TENANTS — estate engine must NOT pass the interest through the deceased estate
  notes               String?

  group  OwnershipGroup @relation(fields: [ownershipGroupId], references: [id], onDelete: Cascade)
  entity LegalEntity    @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([ownershipGroupId])
  @@index([entityId])
  @@map("ownership_stakes")
}

// `BeneficialOwnershipOverride` — asset-scoped record that legal title and
// beneficial ownership differ (nominee / bare trust / custodian). Replaces
// the too-broad entity-to-entity NOMINEE_FOR edge (PHASE_44 §5, §7). Entity
// refs are plain FKs — the lib/entity-graph/ service validates them.
model BeneficialOwnershipOverride {
  id                      String                   @id @default(uuid())
  userId                  String
  legalOwnerEntityId      String // who holds legal title
  beneficialOwnerEntityId String // who is economically entitled
  ownedObjectType         String // asset / shareParcel / ownershipStake / investmentHolding
  ownedObjectId           String
  basis                   BeneficialOwnershipBasis
  effectiveFrom           DateTime                 @default(now())
  effectiveTo             DateTime?
  sourceDocumentId        String?
  accountantVerified      Boolean                  @default(false)
  verifiedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ownedObjectType, ownedObjectId])
  @@map("beneficial_ownership_overrides")
}

// =============================================================================
// PHASE 44 — MONEY-FLOW & TRANSACTIONS (Part 2a — schema)
// Design contract: docs/blueprint/PHASE_44_PART_2_MONEY_FLOW_TAX_REWIRE.md §4.
// The "what actually happened in an income year" layer — persisted
// distribution resolutions, dividends and Div 7A benefits that the Part 2c
// fact-assembler feeds to the tax engine. PURE DATA — no tax computation
// lives here (§8.3). All money / percentage fields Decimal. Additive
// throughout. Entity references are plain-string FKs validated by the
// service layer (the `BeneficialOwnershipOverride` precedent, §3A).
// =============================================================================

// Lifecycle status shared by DistributionResolution + DividendDistribution.
enum ResolutionStatus {
  DRAFT
  CONFIRMED
}

// Div 7A benefit kinds (PHASE_44_PART_2 §4.3). The engine computes the
// LOAN limb today; PAYMENT / DEBT_FORGIVENESS / UPE / SUB_TRUST_ARRANGEMENT
// are recorded and return UNCOMPUTED until the engine's Div 7A coverage is
// extended (§7.1 G-DIV7A). UPE / sub-trust treatment is legally contested
// (§7.1 G-UPE) — the engine never auto-deems them a Div 7A dividend.
enum PrivateCompanyBenefitType {
  LOAN
  PAYMENT
  DEBT_FORGIVENESS
  UPE
  SUB_TRUST_ARRANGEMENT
}

// Structured trust-deed rule kinds (PHASE_44_PART_2 §4.4) — the typed
// promotion of `TrustDeedExtractedRules`' JSON columns into a queryable
// SSOT the tax engine reads.
enum TrustDeedRuleType {
  BENEFICIARY_CLASS
  DISTRIBUTION_METHOD
  DEFAULT_BENEFICIARY
  STREAMING_POWER
  VESTING_DATE
  INCOME_DEFINITION
  SUB_TRUST_UPE_CLAUSE
}

// `DistributionResolution` — a discretionary / unit / fixed / hybrid
// trust's per-FY resolution. Feeds `EntityTaxFacts.trustDistribution`.
// Bamford proportionate model: each allocation's `presentlyEntitledShare`
// is a fraction of the trust-law `distributableIncome`; the engine
// applies that fraction to the s 95 `trustNetIncome` (a tax concept).
model DistributionResolution {
  id                     String           @id @default(uuid())
  userId                 String
  trustEntityId          String // the trust LegalEntity (plain FK — service-validated)
  financialYear          String // "2026-27"
  trustNetIncome         Decimal          @db.Decimal(19, 4) // s95 ITAA 1936 net income (tax concept)
  distributableIncome    Decimal?         @db.Decimal(19, 4) // trust-law income — Q-DISTINCOME (Bamford)
  resolutionDate         DateTime? // trustee resolution date — one input to streaming validity
  frankedDividendPool    Decimal?         @db.Decimal(19, 4) // Div 6E character pool available to stream
  capitalGainPool        Decimal?         @db.Decimal(19, 4)
  hasFamilyTrustElection Boolean          @default(false)
  status                 ResolutionStatus @default(DRAFT)
  accountantVerified     Boolean          @default(false)
  verifiedAt             DateTime?
  sourceDocumentId       String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations DistributionAllocation[]

  @@index([userId])
  @@index([trustEntityId, financialYear])
  @@map("distribution_resolutions")
}

// One beneficiary's slice of a `DistributionResolution`.
model DistributionAllocation {
  id                       String   @id @default(uuid())
  resolutionId             String
  beneficiaryEntityId      String // a BENEFICIARY_OF / UNITHOLDER_OF entity (service-validated)
  presentlyEntitledShare   Decimal  @db.Decimal(9, 6) // fraction of distributable income (0..1)
  streamedFrankedDividends Decimal? @db.Decimal(19, 4) // Subdiv 207-B specific entitlement
  streamedCapitalGains     Decimal? @db.Decimal(19, 4) // Subdiv 115-C specific entitlement
  notes                    String?

  resolution DistributionResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)

  @@index([resolutionId])
  @@index([beneficiaryEntityId])
  @@map("distribution_allocations")
}

// `DividendDistribution` — an actual dividend declared by a company.
// Feeds the Div 207 imputation computation; franking is recorded
// explicitly, never inferred from a rate guess (PHASE_44 §8.2).
model DividendDistribution {
  id                   String           @id @default(uuid())
  userId               String
  companyEntityId      String // the declaring company (plain FK — service-validated)
  financialYear        String
  declaredDate         DateTime
  paymentDate          DateTime? // null = declared, not yet paid (entitlement ≠ cash)
  totalAmount          Decimal          @db.Decimal(19, 4)
  frankingPercentage   Decimal          @db.Decimal(5, 2) // 0..100
  frankingCreditsTotal Decimal          @db.Decimal(19, 4)
  status               ResolutionStatus @default(DRAFT)
  accountantVerified   Boolean          @default(false)
  verifiedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DividendPayment[]

  @@index([userId])
  @@index([companyEntityId, financialYear])
  @@map("dividend_distributions")
}

// One shareholder's slice of a `DividendDistribution`.
model DividendPayment {
  id                     String  @id @default(uuid())
  dividendDistributionId String
  shareholderEntityId    String // a SHAREHOLDER_OF entity (service-validated)
  amount                 Decimal @db.Decimal(19, 4)
  frankingCredits        Decimal @db.Decimal(19, 4)

  dividend DividendDistribution @relation(fields: [dividendDistributionId], references: [id], onDelete: Cascade)

  @@index([dividendDistributionId])
  @@index([shareholderEntityId])
  @@map("dividend_payments")
}

// `PrivateCompanyBenefit` — a Div 7A benefit from a private company to a
// shareholder / associate. The engine computes the LOAN limb; the others
// are recorded + returned UNCOMPUTED (§7.1 G-DIV7A / G-UPE).
model PrivateCompanyBenefit {
  id                     String                    @id @default(uuid())
  userId                 String
  companyEntityId        String // the private company (plain FK — service-validated)
  recipientEntityId      String // shareholder / associate (service-validated)
  financialYear          String
  benefitType            PrivateCompanyBenefitType
  amount                 Decimal                   @db.Decimal(19, 4)
  openingBalance         Decimal?                  @db.Decimal(19, 4) // LOAN
  loanTermYears          Int? // LOAN — 7 or 25 (s109N)
  benchmarkRate          Decimal?                  @db.Decimal(7, 4) // LOAN
  repaymentsThisFy       Decimal?                  @db.Decimal(19, 4) // LOAN
  hasComplianceAgreement Boolean                   @default(false)
  isSubTrustUpe          Boolean                   @default(false)
  accountantVerified     Boolean                   @default(false)
  verifiedAt             DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyEntityId, financialYear])
  @@map("private_company_benefits")
}

// `TrustDeedRule` — structured, queryable deed-derived facts: the typed
// promotion of `TrustDeedExtractedRules`' JSON columns, and the SSOT the
// tax engine reads. `ruleValue` is typed JSON, Zod-validated by the
// service writer. `TrustDeedExtractedRules` is retained as the raw
// PDF-extraction provenance record.
model TrustDeedRule {
  id                  String            @id @default(uuid())
  userId              String
  trustEntityId       String // the trust LegalEntity (plain FK — service-validated)
  sourceExtractionId  String? // provenance — id of the source TrustDeedExtractedRules row
  ruleType            TrustDeedRuleType
  ruleValue           Json // typed per ruleType; Zod-validated at write time
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  extractedConfidence Decimal?          @db.Decimal(4, 3) // 0..1 — AI-extraction confidence
  accountantVerified  Boolean           @default(false)
  verifiedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trustEntityId, ruleType])
  @@map("trust_deed_rules")
}

// =============================================================================
// COMPANY TAX HISTORY (Phase 41E reform 2026-27 — Measure 5)
// =============================================================================

// Per-entity, per-FY tax position record for COMPANY entities. Read by
// `lib/tax-engine/divisions/lossRefundability.ts` to compute carry-back
// eligibility — a company with a loss in FY 2026-27 can carry it back
// against tax paid in FY 2024-25 + FY 2025-26 (subject to the franking
// account balance cap).
//
// See `docs/blueprint/PHASE_41E_REFORM_2026_27.md` §10.5.
model CompanyTaxHistory {
  id                     String   @id @default(uuid())
  legalEntityId          String
  financialYear          String // "2024-25" / "2025-26" / "2026-27"
  taxablePosition        Float // Negative = loss; Positive = profit
  taxPaid                Float    @default(0) // Tax actually paid for the FY (relevant for carry-back refund cap)
  frankingAccountBalance Float    @default(0) // Closing franking-account balance for the FY (caps refund per Measure 5 design)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@unique([legalEntityId, financialYear])
  @@index([legalEntityId])
  @@map("company_tax_history")
}

// =============================================================================
// USER
// =============================================================================

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String? // Nullable for passwordless accounts
  name               String
  role               UserRole  @default(OWNER)
  emailVerified      Boolean   @default(false)
  emailVerifiedAt    DateTime?
  mfaEnabled         Boolean   @default(false)
  mfaEnforcedByOrg   Boolean   @default(false)
  accountLocked      Boolean   @default(false)
  accountLockedUntil DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Phase 12: Onboarding fields
  onboardingCompleted   Boolean                @default(false)
  onboardingProfileType OnboardingProfileType?
  onboardingStartedAt   DateTime?
  onboardingCompletedAt DateTime?
  onboardingStep        Int                    @default(0) // Current wizard step (0-7)

  // Basiq Open Banking Integration
  basiqUserId String? @unique // Basiq user ID for this user

  // Profile Information
  mobile   String? // Australian mobile number for bank verification
  phone    String? // General phone number
  location String? // City/State
  timezone String? @default("Australia/Sydney")
  bio      String? // User bio/description

  // Settings overhaul (2026-05-08) — Trusted contact (estate / handover).
  // Surfaced through the user's own Settings; visible to a future advisor
  // attached via Phase 32B with explicit consent. Never auto-shared.
  trustedContactName         String?
  trustedContactEmail        String?
  trustedContactPhone        String?
  trustedContactRelationship String?
  trustedContactUpdatedAt    DateTime?

  // Settings overhaul (2026-05-08) — Right-to-deletion soft-delete.
  // When a user requests account deletion, deletionRequestedAt is set
  // and deletionScheduledFor = now() + 30 days. The user can cancel
  // (deletionRequestedAt = null) any time before the scheduled date.
  // After the scheduled date, a Cloud Scheduler job hard-deletes the
  // CDR data per CLAUDE.md §13.2 + anonymises the User row.
  deletionRequestedAt  DateTime?
  deletionScheduledFor DateTime?

  // Relationships
  properties         Property[]
  loans              Loan[]
  accounts           Account[]
  income             Income[]
  expenses           Expense[]
  transactions       Transaction[]
  basiqConnections   BasiqConnection[] // Basiq Open Banking connections
  debtPlans          DebtPlan[]
  investmentAccounts InvestmentAccount[]
  assets             Asset[] // Phase 21: Personal assets

  // Phase 47: Signup consent + legal-document acceptance (CLAUDE.md §13, Privacy Act APP 5)
  consents UserConsent[]

  // Phase 10: Auth & Security
  organizationMemberships OrganizationMember[]
  mfaMethods              MFAMethod[]
  sessions                UserSession[]
  auditLogs               AuditLog[]
  passkeyCredentials      PasskeyCredential[]
  magicLinks              MagicLink[]
  oauthAccounts           OAuthAccount[]
  loginAttempts           LoginAttempt[]
  emailMFACodes           EmailMFACode[]

  // Phase 11: AI Strategy Engine
  strategyRecommendations StrategyRecommendation[]
  strategySessions        StrategySession[]
  strategyForecasts       StrategyForecast[]

  // Phase 13: Transactional Intelligence
  unifiedTransactions UnifiedTransaction[]
  recurringPayments   RecurringPayment[]
  spendingProfile     SpendingProfile?

  // Phase 14: Cashflow Optimisation Engine
  cashflowForecasts  CashflowForecast[]
  cashflowInsights   CashflowInsight[]
  cashflowStrategies CashflowStrategy[]

  // Phase 18: Bank Transaction Import
  bankImportFiles BankImportFile[]
  budgetTargets   BudgetTarget[]

  // Phase 19: Document Management
  documents             Document[]
  storageProviderConfig StorageProviderConfig?
  vendorEntityHints     VendorEntityHint[] // Phase 50 D.4: learned routing (suggest-only)

  // Phase 20: Australian Tax Intelligence Engine
  superannuationAccounts SuperannuationAccount[]
  smsfAnnualReturns      SmsfAnnualReturn[] // Phase 44.2: persisted SMSF fund-tax figures
  taxPositions           TaxPosition[]

  // Phase 12: User Preferences
  userPreference UserPreference?

  // Phase 21.5 Tier 2: per-user reminder snooze/dismiss/done state
  reminderStates ReminderState[]

  // Phase 21.5 Tier 2: user-created custom reminders
  customReminders Reminder[]

  // Phase R-Charts-2 (2026-05-30): per-month net-worth snapshot store —
  // replaces the simulated `generateNetWorthTrendData` (Math.random) used
  // by the legacy NetWorth Trend tile. Honest data; the editorial trend
  // chart shows a quiet empty state until ≥2 months of snapshots accrue.
  netWorthSnapshots NetWorthSnapshot[]

  // Phase 28: Realistic Budget Integration
  householdProfile HouseholdProfile?
  budgetAnalyses   BudgetAnalysis[]
  debtAnalyses     DebtAnalysis[]

  // Phase 29: Cashflow Intelligence Center
  cashflowSummaries CashflowSummary[]

  // Custom Categories
  categories Category[]

  // Phase 29: AI Categorisation & Learning
  aiCategorizationLearnings AICategorizationLearning[] @relation("AICategorizationLearnings")
  importBatches             ImportBatch[]              @relation("ImportBatches")
  transactionReviewQueue    TransactionReviewQueue[]   @relation("TransactionReviewQueue")

  // Phase 42 PR1: Consumer bookkeeping foundation
  canonicalCategoryRegistry CanonicalCategoryRegistry[]
  bookkeepingPeriods        BookkeepingPeriod[]
  transactionEdits          TransactionEdit[]
  // Phase 42 PR5
  vendors                   Vendor[]
  taxCategoryMappings       TaxCategoryMapping[]
  // Phase 42 PR6 — engagement layer state (one row per user).
  engagementState           EngagementState?

  // Phase L: CDR Compliance Models
  cdrConsents    CDRConsent[]
  cdrComplaints  CDRComplaint[]
  cdrDisclosures CDRDisclosure[]

  // Phase 38 PR 3: My Vault — Share Pass (accountant share-link, future
  // generic share engine for Reports / property summaries / net worth).
  sharePackages SharePackage[]

  // Phase 40: My Guide — AI Financial Advice (cached advice docs + chat).
  aiAdviceDocuments AIAdviceDocument[]

  // Phase 41: Entity Layer — every user has at least one LegalEntity (their
  // PERSONAL_NAME entity is created during onboarding and backfilled for
  // existing users by migration `20260504130000_add_legal_entity`).
  legalEntities LegalEntity[]

  // Phase 44: Entity Graph — the relationship edges, ownership groups, and
  // beneficial-ownership overrides in this user's structure.
  entityRelationships          EntityRelationship[]
  ownershipGroups              OwnershipGroup[]
  beneficialOwnershipOverrides BeneficialOwnershipOverride[]

  // Phase 44 Part 2: money-flow & transaction records.
  distributionResolutions DistributionResolution[]
  dividendDistributions   DividendDistribution[]
  privateCompanyBenefits  PrivateCompanyBenefit[]
  trustDeedRules          TrustDeedRule[]

  // Phase 41f: bookkeeping integrations the user has connected for any of
  // their LegalEntities (USER_ENTITY scope). Cascades on user delete via
  // the user → integration FK; the entity → integration cascade also runs.
  accountingIntegrations AccountingIntegration[]

  // Phase 32C PR4a: Marketplace ratings — a user can rate a professional
  // listing they've engaged with (one rating per listing per user).
  professionalRatings ProfessionalRating[]

  // Phase 32C PR4c: requests this user has submitted to professional listings.
  professionalRequests ProfessionalRequest[]

  // Phase 33g: Adviser feedback inbox. A user can author feedback threads
  // (when they're an adviser hitting `/portal/feedback`) and reply to threads
  // as either the original adviser OR a Monitrax admin (when Reza replies
  // from `/admin/feedback`, the FeedbackMessage.authorRole disambiguates).
  feedbackThreads  FeedbackThread[]
  feedbackMessages FeedbackMessage[]

  // Phase 32C PR4d: conversations this user is a participant in (typically
  // one per ACCEPTED engagement). Includes both the consumer side (linked
  // via this relation) and any messages they've sent.
  conversationParticipations ConversationParticipant[]
  conversationMessages       ConversationMessage[]     @relation("ConversationMessageSender")

  @@map("users")
}

// =============================================================================
// CUSTOM CATEGORIES - User-defined expense and income categories
// =============================================================================

model Category {
  id          String       @id @default(uuid())
  userId      String
  name        String // Display name (e.g., "Pet Care", "Side Business")
  type        CategoryType // EXPENSE or INCOME
  code        String // Unique code for the category (e.g., "PET_CARE")
  description String? // Optional description
  color       String? // Optional hex color for UI (e.g., "#FF5733")
  icon        String? // Optional icon name (e.g., "paw", "briefcase")
  isSystem    Boolean      @default(false) // True for system-default categories
  isActive    Boolean      @default(true) // Allow soft-delete/deactivation
  sortOrder   Int          @default(0) // For custom ordering
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Phase 29: Link categories to household members/pets for personalized tracking
  householdMemberId String? // Links to a household member (e.g., "Reza's Salary")
  householdPetId    String? // Links to a household pet (e.g., "Fandogh Pet Insurance")

  // Relationships
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses        Expense[]        @relation("ExpenseCustomCategory")
  income          Income[]         @relation("IncomeCustomCategory")
  householdMember HouseholdMember? @relation("MemberLinkedCategories", fields: [householdMemberId], references: [id], onDelete: SetNull)
  householdPet    HouseholdPet?    @relation("PetLinkedCategories", fields: [householdPetId], references: [id], onDelete: SetNull)

  @@unique([userId, code]) // Each user can have unique category codes
  @@index([userId])
  @@index([userId, type])
  @@index([householdMemberId])
  @@index([householdPetId])
  @@map("categories")
}

// =============================================================================
// PHASE 12: USER PREFERENCES
// =============================================================================

model UserPreference {
  id     String @id @default(uuid())
  userId String @unique

  // Tour state
  hasSeenGuidedTour Boolean   @default(false)
  tourSkippedAt     DateTime?
  tourCompletedAt   DateTime?

  // Onboarding UI state
  dismissedOnboardingBadge Boolean @default(false)
  dismissedWelcomeModal    Boolean @default(false)

  // Phase 41E.3 — "Tax rules are changing" one-time CFO Guide card.
  // Calm-framing reform announcement banner. Per Reza confirmation
  // 2026-05-16: one-time, dismissable, accessible later via CFO Guide.
  // Default false (banner shows until user dismisses).
  dismissedReformBanner Boolean @default(false)

  // Phase 12 PR 3c.2b — "Connect your bank for fresh balances" first-
  // visit migration modal. Shown once to existing users with ≥1 MANUAL
  // account; once dismissed (any choice — Connect / Import / Keep
  // manual) never shown again. Always reachable via Settings > Data
  // Health (PR J) for users who want to revisit the choice.
  dismissedBalanceUpgradeNudge Boolean @default(false)

  // User preference settings
  preferredCurrency   String  @default("AUD")
  preferredDateFormat String  @default("DD/MM/YYYY")
  country             String  @default("AU")
  taxYear             String? // e.g. "2025-2026" (AU FY). Null until the user sets it.

  // Phase 12 PR 2: Onboarding wizard draft state.
  // Stores the in-progress WizardData blob so users can resume a partial
  // setup across devices. Cleared (set to null) when bulk-create succeeds.
  // Null for users who have either not started or already completed onboarding.
  onboardingDraft Json?

  // Notification preferences (Phase 10)
  emailWeeklyDigest   Boolean @default(true)
  emailMonthlyReport  Boolean @default(true)
  emailAlerts         Boolean @default(true)
  emailProductUpdates Boolean @default(false)
  pushCashflowAlerts  Boolean @default(false)
  pushSpendingAlerts  Boolean @default(false)
  pushGoalUpdates     Boolean @default(false)
  pushBillReminders   Boolean @default(false)

  // Settings overhaul (2026-05-08) — Appearance preferences that the
  // /dashboard/settings/appearance UI exposed without ever persisting.
  // Theme is stored server-side so the choice survives across devices;
  // next-themes still owns the runtime application via cookie + DOM.
  // financialYearStart is a "MM-DD" string so non-AU users can override
  // the AU default when their country preference doesn't already imply it.
  theme              String  @default("system") // 'light' | 'dark' | 'system'
  showCents          Boolean @default(true)
  compactMode        Boolean @default(false)
  financialYearStart String  @default("07-01") // ISO MM-DD

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// =============================================================================
// PROPERTY
// =============================================================================

model Property {
  id            String       @id @default(uuid())
  userId        String
  ownerEntityId String // Phase 41: which LegalEntity owns this property — backfilled to user's PERSONAL_NAME entity
  name          String
  type          PropertyType
  address       String?
  purchasePrice Float
  purchaseDate  DateTime
  currentValue  Float
  valuationDate DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Phase 41E reform 2026-27 — grandfathering inputs (CLAUDE.md §12.14).
  // The load-bearing column is `acquisitionContractDate` — the CGT-event-A1
  // date per s109-5 ITAA 1997 (NOT settlement, NOT registration). Distinct
  // from the existing `purchaseDate` (ambiguous — could be either). The
  // reform cut-over (7:30pm AEST 12 May 2026 = `2026-05-12T09:30:00Z` UTC,
  // stored as `REFORM_CUT_OVER_UTC` in `lib/tax-engine/config/reformConstants.ts`)
  // is contract-based. See `docs/blueprint/PHASE_41E_REFORM_2026_27.md` §4.2 + §10.
  acquisitionContractDate    DateTime? // Contract date (CGT event A1) — the grandfathering test reads this
  acquisitionSettlementDate  DateTime? // Settlement date — for clarity + edge cases (off-the-plan)
  isNewBuild                 Boolean? // User-confirmed; UNCOMPUTED on post-cut-over acquisitions if unset (Measure 1)
  newBuildEvidence           NewBuildEvidence? // Audits the isNewBuild claim
  isRenewablesInfrastructure Boolean? // For Measure 4 — 50% concession on qualifying renewables until 30 Jun 2030

  // Location data (Google Maps integration)
  latitude      Float? // Latitude coordinate
  longitude     Float? // Longitude coordinate
  googlePlaceId String? // Google Places API place_id
  suburb        String? // Suburb/locality
  state         String? // State (e.g., NSW, VIC)
  postcode      String? // Postal code

  // Property renewal dates (Phase 21.5 extension). All nullable, optional.
  // These drive in-app renewal reminders via the canonical reminder engine
  // (lib/reminders/reminderEngine.ts) — the dates ARE the source of truth;
  // no derived Reminder table. Phase 41E reform note (CLAUDE.md §12.14 FW-3):
  // these are OPERATIONAL reminder inputs (rates/insurance/strata/lease/
  // compliance cadence). They do NOT interact with the CGT grandfathering
  // test — that remains driven solely by `acquisitionContractDate`. No
  // reform regime math reads these columns.
  councilRatesDueDate           DateTime? // Council rates next due
  waterRatesDueDate             DateTime? // Water rates next due
  landTaxDueDate                DateTime? // Land tax assessment next due
  buildingInsuranceProvider     String? // Building & contents insurer
  buildingInsurancePolicyNumber String? // Building & contents policy number
  buildingInsuranceExpiry       DateTime? // Building & contents renewal due
  strataDueDate                 DateTime? // Strata / body-corporate levy next due
  leaseExpiry                   DateTime? // Lease / rent-review date (rentals + tenanted investments)
  complianceCertExpiry          DateTime? // Smoke-alarm / pool-safety / gas compliance certificate expiry

  // Phase 45.2.5 — user-uploadable hero photo for the property detail page.
  // v1 stores the image inline as a Postgres BYTEA (≤5MB, JPEG/PNG/WEBP). The
  // §18.7.4 Cremorne pattern intentionally treats the photo as decor — never
  // evidence — so the bytes are NOT CDR-classified. Detail page falls back to
  // the default Cremorne apartment photo when these columns are null.
  // Future migration to GCS via lib/documents/storage is queued (no schema
  // churn required — the API surface stays stable; only the storage backend
  // moves).
  heroImage     Bytes?
  heroImageMime String?

  // Relationships
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerEntity           LegalEntity            @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)
  loans                 Loan[]
  income                Income[]
  expenses              Expense[]
  depreciationSchedules DepreciationSchedule[]

  @@index([userId])
  @@index([ownerEntityId])
  @@index([acquisitionContractDate]) // Phase 41E — grandfathering test reads this on every snapshot
  @@map("properties")
}

// =============================================================================
// LOAN
// =============================================================================

model Loan {
  id                  String             @id @default(uuid())
  userId              String
  ownerEntityId       String // Phase 41: which LegalEntity owes this debt — backfilled to user's PERSONAL_NAME entity
  propertyId          String?
  offsetAccountId     String?            @unique
  linkedAssetId       String? // For CAR loans - link to vehicle asset
  linkedAccountId     String? // For LINE_OF_CREDIT - link to credit card/account
  name                String
  type                LoanType
  principal           Float // Current balance
  interestRateAnnual  Float // e.g., 0.0625 for 6.25%
  rateType            RateType
  fixedExpiry         DateTime? // When fixed rate expires
  isInterestOnly      Boolean            @default(false)
  termMonthsRemaining Int
  minRepayment        Float // Current required payment
  repaymentFrequency  RepaymentFrequency
  extraRepaymentCap   Float? // Annual cap for extra repayments on fixed loans
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relationships
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerEntity   LegalEntity    @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)
  property      Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  offsetAccount Account?       @relation(fields: [offsetAccountId], references: [id], onDelete: SetNull)
  linkedAsset   Asset?         @relation(fields: [linkedAssetId], references: [id], onDelete: SetNull)
  linkedAccount Account?       @relation("LoanLinkedAccount", fields: [linkedAccountId], references: [id], onDelete: SetNull)
  expenses      Expense[]
  debtPlanLoans DebtPlanLoan[]

  @@index([userId])
  @@index([ownerEntityId])
  @@index([propertyId])
  @@index([linkedAssetId])
  @@index([linkedAccountId])
  @@map("loans")
}

// =============================================================================
// ACCOUNT
// =============================================================================

model Account {
  id             String      @id @default(uuid())
  userId         String
  ownerEntityId  String // Phase 41: which LegalEntity owns this account — backfilled to user's PERSONAL_NAME entity
  name           String
  type           AccountType
  institution    String?
  currentBalance Float
  interestRate   Float? // Annual interest rate (e.g., 0.025 for 2.5%)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Balance Source Tracking
  balanceSource        BalanceSource @default(MANUAL) // Where the balance came from
  balanceLastUpdatedAt DateTime? // When balance was last updated
  lastImportedBalance  Float? // Balance from most recent import

  // Basiq Open Banking Integration
  basiqAccountId    String?   @unique // Basiq account ID (if linked via Open Banking)
  basiqConnectionId String? // Basiq connection ID
  basiqLastSynced   DateTime? // Last time data was synced from Basiq
  accountNumber     String? // Masked account number from bank
  bsb               String? // BSB (for AU banks)

  // Relationships
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerEntity     LegalEntity      @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)
  basiqConnection BasiqConnection? @relation(fields: [basiqConnectionId], references: [id], onDelete: SetNull)
  transactions    Transaction[]
  linkedLoan      Loan? // One-to-one: this account can be an offset for one loan
  creditLineLoans Loan[]           @relation("LoanLinkedAccount") // LINE_OF_CREDIT loans linked to this account

  // Phase 13: Transactional Intelligence
  unifiedTransactions UnifiedTransaction[] @relation("UnifiedTransactions")
  recurringPayments   RecurringPayment[]   @relation("RecurringPayments")

  // Phase 14: Cashflow Optimisation Engine
  cashflowForecasts CashflowForecast[]

  // Phase 29: AI Categorisation & Import Batches
  importBatches ImportBatch[] @relation("ImportBatches")

  @@index([userId])
  @@index([ownerEntityId])
  @@index([basiqConnectionId])
  @@map("accounts")
}

// =============================================================================
// BASIQ CONNECTION (Open Banking)
// =============================================================================

enum BasiqConnectionStatus {
  ACTIVE // Connection is active and syncing
  PENDING // Awaiting user consent
  RECONNECT // Needs re-authentication
  DISABLED // User disabled this connection
  ERROR // Connection error
}

model BasiqConnection {
  id                String                @id @default(uuid())
  userId            String
  basiqConnectionId String                @unique // Basiq's connection ID
  institutionId     String // Basiq institution ID
  institutionName   String // Bank name (e.g., "Commonwealth Bank")
  institutionLogo   String? // Logo URL
  status            BasiqConnectionStatus @default(PENDING)
  lastSyncedAt      DateTime?
  lastSyncError     String?

  // Fix: G19 — CDR consent tracking fields (Basiq provides consent metadata)
  consentExpiresAt DateTime? // When CDR consent for this connection expires
  consentScope     String? // CDR data scope granted (e.g., "accounts,transactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId])
  @@index([status])
  @@index([consentExpiresAt])
  @@map("basiq_connections")
}

// =============================================================================
// CDR COMPLIANCE MODELS (Phase L — CDR Code-Level Remediation)
// =============================================================================

// Fix: G18 — Explicit CDR consent record for CDR Rules compliance.
// CDR requires tracking of informed, explicit consent with scope, duration, and legal basis.
model CDRConsent {
  id                String           @id @default(uuid())
  userId            String
  consentStatus     CDRConsentStatus @default(PENDING)
  scope             String[] // CDR data scopes granted (e.g., ["accounts", "transactions", "balances"])
  legalBasis        String? // Legal basis for data collection (e.g., "consumer_consent")
  grantedAt         DateTime?
  expiresAt         DateTime?
  revokedAt         DateTime?
  revokedReason     String?
  basiqConnectionId String? // Link to Basiq connection if applicable
  organizationId    String? // Link to org if consent is via organization
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consentStatus])
  @@index([expiresAt])
  @@map("cdr_consents")
}

enum CDRConsentStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  WITHDRAWN
}

// Fix: G43 — CDR complaint tracking model for CDR record-keeping requirements.
// CDR compliance requires tracking all consumer complaints about CDR data handling.
model CDRComplaint {
  id               String               @id @default(uuid())
  userId           String? // Complainant (null if external)
  complainantName  String?
  complainantEmail String?
  category         CDRComplaintCategory
  description      String
  status           CDRComplaintStatus   @default(OPEN)
  resolution       String?
  resolvedAt       DateTime?
  resolvedBy       String?
  escalatedToOAIC  Boolean              @default(false)
  oaicReferenceId  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // Relationships
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("cdr_complaints")
}

enum CDRComplaintCategory {
  DATA_ACCESS // Complaint about CDR data access
  DATA_DELETION // Complaint about CDR data not being deleted
  CONSENT_MANAGEMENT // Complaint about consent handling
  DATA_ACCURACY // Complaint about CDR data accuracy
  PRIVACY // General privacy complaint
  SERVICE // Service-related complaint
  OTHER
}

enum CDRComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED
  CLOSED
}

// Fix: G43 — CDR disclosure tracking model.
// CDR record-keeping requires logging all instances where CDR data was disclosed.
model CDRDisclosure {
  id             String            @id @default(uuid())
  userId         String
  disclosedTo    String // Entity CDR data was disclosed to
  disclosureType CDRDisclosureType
  dataScope      String[] // What CDR data was disclosed
  legalBasis     String // Legal basis for disclosure
  consentId      String? // Link to CDR consent if applicable
  createdAt      DateTime          @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("cdr_disclosures")
}

enum CDRDisclosureType {
  CONSUMER_REQUESTED // Consumer requested their data be shared
  REGULATORY // Required by regulation (e.g., OAIC request)
  LEGAL // Legal proceedings
  INTERNAL // Internal use within organization
}

// =============================================================================
// INCOME
// =============================================================================

model Income {
  id                  String           @id @default(uuid())
  userId              String
  ownerEntityId       String // Phase 41: which LegalEntity receives this income — backfilled to user's PERSONAL_NAME entity
  propertyId          String?
  investmentAccountId String?
  customCategoryId    String? // Custom user-defined category (overrides 'type' enum if set)
  name                String
  type                IncomeType       @default(OTHER) // System type (fallback when customCategoryId is null)
  sourceType          IncomeSourceType @default(GENERAL)
  amount              Float
  frequency           Frequency

  // Phase 20: Salary-specific fields (only applicable when type = SALARY)
  salaryType   SalaryType? // GROSS or NET (null for non-salary)
  payFrequency PayFrequency? // Pay cycle frequency

  // Phase 20: Calculated fields for salary
  grossAmount     Float? // If NET entered, calculated GROSS
  netAmount       Float? // If GROSS entered, calculated NET
  paygWithholding Float? // Calculated PAYG withholding (annual)

  // Phase 20: Superannuation (for SALARY type)
  superGuaranteeRate   Float? // e.g., 0.115 for 11.5%
  superGuaranteeAmount Float? // Calculated SG amount (annual)
  salarySacrifice      Float? // Pre-tax super sacrifice (annual)

  // Phase 20: Tax determination (auto-calculated, replaces isTaxable)
  taxCategory        TaxCategory? // System-determined category
  taxableAmount      Float? // The taxable portion
  taxExemptAmount    Float? // Any exempt portion
  frankingCredits    Float? // For dividends
  frankingPercentage Float? // Franking percentage (0-100)
  taxNotes           String? // Explanation of tax treatment

  // Legacy field - kept for backward compatibility, will be deprecated
  isTaxable Boolean @default(true)

  // Phase 30: Budget vs Actual Reconciliation
  budgetedAmount Float? // Original budgeted/estimated amount (preserved when actual updates)
  lastReconciled DateTime? // When amount was last updated from real transactions

  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relationships
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerEntity        LegalEntity         @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)
  property           Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  investmentAccount  InvestmentAccount?  @relation(fields: [investmentAccountId], references: [id], onDelete: SetNull)
  customCategory     Category?           @relation("IncomeCustomCategory", fields: [customCategoryId], references: [id], onDelete: SetNull)
  transactions       Transaction[]
  superContributions SuperContribution[]

  @@index([userId])
  @@index([ownerEntityId])
  @@index([propertyId])
  @@index([investmentAccountId])
  @@index([customCategoryId])
  @@map("income")
}

// =============================================================================
// EXPENSE
// =============================================================================

model Expense {
  id                  String            @id @default(uuid())
  userId              String
  ownerEntityId       String // Phase 41: which LegalEntity bears this expense — backfilled to user's PERSONAL_NAME entity
  propertyId          String?
  loanId              String?
  investmentAccountId String?
  assetId             String? // Phase 21: Link to asset
  customCategoryId    String? // Custom user-defined category (overrides 'category' enum if set)
  name                String
  vendorName          String?
  category            ExpenseCategory   @default(OTHER) // System category (fallback when customCategoryId is null)
  sourceType          ExpenseSourceType @default(GENERAL)
  amount              Float
  frequency           Frequency
  isEssential         Boolean           @default(true)
  isTaxDeductible     Boolean           @default(false)
  isRecurring         Boolean           @default(true) // Is this a recurring expense or one-off/discretionary?

  // Phase 30: Budget vs Actual Reconciliation
  budgetedAmount Float? // Original budgeted/estimated amount (preserved when actual updates)
  lastReconciled DateTime? // When amount was last updated from real transactions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerEntity       LegalEntity        @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)
  property          Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  loan              Loan?              @relation(fields: [loanId], references: [id], onDelete: SetNull)
  investmentAccount InvestmentAccount? @relation(fields: [investmentAccountId], references: [id], onDelete: SetNull)
  asset             Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  customCategory    Category?          @relation("ExpenseCustomCategory", fields: [customCategoryId], references: [id], onDelete: SetNull)
  transactions      Transaction[]

  // Phase 29: Linked recurring payments from bank detection
  linkedRecurringPayments RecurringPayment[] @relation("RecurringPaymentExpense")

  @@index([userId])
  @@index([ownerEntityId])
  @@index([propertyId])
  @@index([loanId])
  @@index([investmentAccountId])
  @@index([assetId])
  @@index([customCategoryId])
  @@map("expenses")
}

// =============================================================================
// TRANSACTION
// =============================================================================

model Transaction {
  id          String               @id @default(uuid())
  userId      String
  accountId   String
  propertyId  String?
  loanId      String?
  incomeId    String?
  expenseId   String?
  date        DateTime
  description String
  amount      Float
  direction   TransactionDirection
  category    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Relationships
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  income  Income?  @relation(fields: [incomeId], references: [id], onDelete: SetNull)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([accountId])
  @@index([date])
  @@map("transactions")
}

// =============================================================================
// DEBT PLAN (Optional storage of debt planner results)
// =============================================================================

model DebtPlan {
  id                 String       @id @default(uuid())
  userId             String
  name               String
  strategy           DebtStrategy
  surplusPerPeriod   Float
  surplusFrequency   Frequency
  emergencyBuffer    Float        @default(0)
  respectFixedCaps   Boolean      @default(true)
  rolloverRepayments Boolean      @default(true)
  totalInterestPaid  Float
  totalInterestSaved Float
  debtFreeDate       DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relationships
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanDetails DebtPlanLoan[]

  @@index([userId])
  @@map("debt_plans")
