  updatedAt DateTime @updatedAt

  @@map("organization_portal_settings")
}

// =============================================================================
// PHASE 32: ORGANIZATION CLIENT (Link between Org and User)
// =============================================================================

model OrganizationClient {
  id             String @id @default(uuid())
  organizationId String
  userId         String // The client's user account

  // Status
  status ClientStatus @default(INVITED)

  // Consent Management
  consentStatus    ConsentStatus     @default(PENDING)
  accessScopes     DataAccessScope[] @default([])
  consentGrantedAt DateTime?
  consentExpiresAt DateTime? // Optional expiry
  consentRevokedAt DateTime?

  // Assignment (which staff member manages this client)
  assignedToMemberId String? // OrganizationMember ID

  // Client Reference (org's internal reference)
  clientReference String? // e.g., "CLI-001"
  externalId      String? // ID in external system (Xero, etc.)

