// =============================================================================
// PHASE 3: INVESTMENT ENUMS
// =============================================================================

enum InvestmentAccountType {
  BROKERAGE
  SUPERS
  FUND
  TRUST
  ETF_CRYPTO
}

enum HoldingType {
  SHARE
  ETF
  MANAGED_FUND
  CRYPTO
}

enum InvestmentTransactionType {
  BUY
  SELL
  DIVIDEND
  DISTRIBUTION
  DRP
  DEPOSIT // Cash deposit into account
  WITHDRAWAL // Cash withdrawal from account
  TRANSFER_IN // Assets transferred in (e.g., from another broker)
  TRANSFER_OUT // Assets transferred out
  CORPORATE_ACTION // Stock splits, mergers, etc.
}

// Phase 23: Capital Gains Tax Tracking
enum CostBasisMethod {
  FIFO // First In, First Out
  LIFO // Last In, First Out
  HIFO // Highest In, First Out (tax optimized)
  SPECIFIC // Specific identification
  AVERAGE // Average cost (for managed funds)
}

enum CapitalGainType {
  SHORT_TERM // Held < 12 months (no CGT discount)
  LONG_TERM // Held >= 12 months (50% CGT discount applies)
}

enum DepreciationCategory {
  DIV40
  DIV43
}

enum DepreciationMethod {
  PRIME_COST
  DIMINISHING_VALUE
}

// =============================================================================
// PHASE 21: ASSET MANAGEMENT ENUMS
// =============================================================================

enum AssetType {
  VEHICLE
  ELECTRONICS
  FURNITURE
  EQUIPMENT
  COLLECTIBLE
  OTHER
}

enum AssetStatus {
  ACTIVE // Currently owned
  SOLD // Sold/disposed
  WRITTEN_OFF // Written off (damaged/lost)
}

enum VehicleFuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  LPG
  OTHER
}

// =============================================================================
// PHASE 3: INVESTMENT ACCOUNT
// =============================================================================

model InvestmentAccount {
  id            String                @id @default(uuid())
  userId        String
  ownerEntityId String // Phase 41: which LegalEntity owns this investment account — backfilled to user's PERSONAL_NAME entity
  name          String
  type          InvestmentAccountType
  platform      String? // e.g. CommSec, SelfWealth, Betashares app
  currency      String                @default("AUD")

  // Phase 23: Balance tracking fields
  openingDate           DateTime?
  openingBalance        Float           @default(0)
  openingBalanceDecimal Decimal?        @db.Decimal(19, 4)
  cashBalance           Float           @default(0)
  cashBalanceDecimal    Decimal?        @db.Decimal(19, 4)
  totalDeposits         Float           @default(0)
  totalDepositsDecimal  Decimal?        @db.Decimal(19, 4)
  totalWithdrawals      Float           @default(0)
  costBasisMethod       CostBasisMethod @default(FIFO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerEntity  LegalEntity             @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)
  holdings     InvestmentHolding[]
  transactions InvestmentTransaction[]
  incomes      Income[]
  expenses     Expense[]
  capitalGains CapitalGainEvent[]

  @@index([userId])
  @@index([ownerEntityId])
  @@map("investment_accounts")
}

// =============================================================================
// PHASE 3: INVESTMENT HOLDING
// =============================================================================

model InvestmentHolding {
  id                  String      @id @default(uuid())
  investmentAccountId String
  ticker              String // VAS, A200, VGS, BHP
  name                String? // Full name (e.g., "Vanguard Australian Shares ETF")
  units               Float
  averagePrice        Float
  frankingPercentage  Float? // AU feature for franking credits
  type                HoldingType

  // Phase 23: Enhanced tracking
  firstPurchaseDate DateTime? // Date of first purchase (for CGT discount)
  totalCostBasis    Float     @default(0) // Total amount invested
  currentPrice      Float? // Latest market price per unit
  currentValue      Float? // units * currentPrice (computed on update)
  priceUpdatedAt    DateTime? // When price was last updated
  unrealizedGain    Float? // currentValue - totalCostBasis
  unrealizedGainPct Float? // Percentage gain/loss

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  investmentAccount InvestmentAccount       @relation(fields: [investmentAccountId], references: [id], onDelete: Cascade)
  transactions      InvestmentTransaction[]
  purchaseLots      PurchaseLot[]
  capitalGains      CapitalGainEvent[]

  @@index([investmentAccountId])
  @@index([ticker])
  @@map("investment_holdings")
}

// =============================================================================
// PHASE 3: INVESTMENT TRANSACTION
// =============================================================================

model InvestmentTransaction {
  id                  String                    @id @default(uuid())
  investmentAccountId String
  holdingId           String?
  date                DateTime
  type                InvestmentTransactionType
  price               Float
  units               Float
  fees                Float?
  notes               String?

  // Phase 23: Enhanced transaction tracking
  ticker       String? // For BUY/SELL when holdingId not yet created
  totalAmount  Float? // price * units + fees (for reporting)
  exchangeRate Float? // For foreign currency transactions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  investmentAccount InvestmentAccount  @relation(fields: [investmentAccountId], references: [id], onDelete: Cascade)
  holding           InvestmentHolding? @relation(fields: [holdingId], references: [id], onDelete: SetNull)
  purchaseLot       PurchaseLot? // Created when this is a BUY transaction
  capitalGainEvent  CapitalGainEvent? // Created when this is a SELL transaction

  @@index([investmentAccountId])
  @@index([holdingId])
  @@index([date])
  @@map("investment_transactions")
}

// =============================================================================
// PHASE 23: PURCHASE LOT (PARCEL) TRACKING FOR CGT
// =============================================================================

model PurchaseLot {
  id            String @id @default(uuid())
  holdingId     String
  transactionId String @unique

  // Lot details
  purchaseDate DateTime
  units        Float // Units in this lot
  unitCost     Float // Price per unit at purchase
  totalCost    Float // units * unitCost + fees
  fees         Float    @default(0)

  // Tracking
  unitsRemaining Float // Units not yet sold (starts = units)
  isFullySold    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  holding                InvestmentHolding          @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  transaction            InvestmentTransaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  capitalGainAllocations CapitalGainLotAllocation[]

  @@index([holdingId])
  @@index([purchaseDate])
  @@map("purchase_lots")
}

// =============================================================================
// PHASE 23: CAPITAL GAIN EVENT (REALIZED GAINS/LOSSES)
// =============================================================================

model CapitalGainEvent {
  id                  String @id @default(uuid())
  investmentAccountId String
  holdingId           String
  transactionId       String @unique

  // Sale details
  saleDate      DateTime
  unitsSold     Float
  salePrice     Float // Price per unit at sale
  saleFees      Float    @default(0)
  grossProceeds Float // unitsSold * salePrice - saleFees

  // Cost basis (calculated from allocated lots)
  totalCostBasis Float // Sum of cost from allocated purchase lots

  // Gain/Loss calculation
  capitalGain     Float // grossProceeds - totalCostBasis
  capitalGainType CapitalGainType // SHORT_TERM or LONG_TERM
  cgtDiscount     Float           @default(0) // 50% discount if LONG_TERM
  taxableGain     Float // capitalGain - cgtDiscount

  // Tax year tracking
  financialYear String // e.g., "2024-25"

  // Additional info
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  investmentAccount InvestmentAccount          @relation(fields: [investmentAccountId], references: [id], onDelete: Cascade)
  holding           InvestmentHolding          @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  transaction       InvestmentTransaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  lotAllocations    CapitalGainLotAllocation[]

  @@index([investmentAccountId])
  @@index([holdingId])
  @@index([financialYear])
  @@index([saleDate])
  @@map("capital_gain_events")
}

// =============================================================================
// PHASE 23: CAPITAL GAIN LOT ALLOCATION (WHICH LOTS WERE SOLD)
// =============================================================================

model CapitalGainLotAllocation {
  id                 String @id @default(uuid())
  capitalGainEventId String
  purchaseLotId      String

  // Allocation details
  unitsAllocated     Float // How many units from this lot were sold
  costBasisAllocated Float // Proportional cost basis
  holdingPeriodDays  Int // Days between purchase and sale

  createdAt DateTime @default(now())

  // Relationships
  capitalGainEvent CapitalGainEvent @relation(fields: [capitalGainEventId], references: [id], onDelete: Cascade)
  purchaseLot      PurchaseLot      @relation(fields: [purchaseLotId], references: [id], onDelete: Cascade)

  @@index([capitalGainEventId])
  @@index([purchaseLotId])
  @@map("capital_gain_lot_allocations")
}

// =============================================================================
// PHASE 3: DEPRECIATION SCHEDULE
// =============================================================================

model DepreciationSchedule {
  id         String               @id @default(uuid())
  propertyId String
  category   DepreciationCategory
  assetName  String
  cost       Float
  startDate  DateTime
  rate       Float // 2.5% for Div43, or effective life rate
  method     DepreciationMethod // PRIME_COST | DIMINISHING_VALUE
  notes      String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  // Relationships
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("depreciation_schedules")
}

// =============================================================================
// PHASE 10: ORGANIZATION & MULTI-TENANT
// =============================================================================

model Organization {
  id                   String           @id @default(uuid())
  name                 String
  slug                 String           @unique
  description          String?
  // Profession is the canonical "what kind of firm is this?" field. Drives the
  // Practice dashboard layout, alert library defaults, scope presets, and
  // AFSL/credit-licence guardrails. Must be chosen at registration (force; no
  // MULTI). Re-uses the existing `OrganizationType` enum so the legacy
  // `OrganizationPortalSettings.organizationType` becomes a shadow — see
  // `docs/IMPLEMENTATION_PLAN.md` 🗑️ Dead Code for the dedup follow-up.
  profession           OrganizationType @default(FINANCIAL_ADVISOR)
  mfaEnforced          Boolean          @default(false)
  sessionDurationHours Int              @default(168) // 7 days
  allowedDomains       String[] // Email domain restrictions
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  // Relationships
  members                 OrganizationMember[]
  auditLogs               AuditLog[]
  strategyRecommendations StrategyRecommendation[]
  professionalListing     ProfessionalListing?

  // Phase 33g: Adviser feedback threads can carry org context (so Reza can
  // filter the inbox by org). Set on creation to the adviser's currentOrg.
  feedbackThreads FeedbackThread[]

  // Phase 32C PR4d: conversations owned by this org (one per accepted
  // request, plus org-attached client conversations from ClientLink).
  conversations ProfessionalConversation[]

  // Phase 32C PR6: Stripe billing — one customer record per Org once the
  // owner first enters the billing flow; subscription state mirrored from
  // Stripe webhooks. Test-mode at v1; live mode wires post-Basiq.
  stripeCustomer     StripeCustomer?
  stripeSubscription StripeSubscription?

  @@map("organizations")
}

model OrganizationMember {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  role           UserRole  @default(VIEWER)
  invitedBy      String? // User ID who sent the invitation
  invitedAt      DateTime  @default(now())
  joinedAt       DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phase 32C PR4c: marketplace requests this member has responded to.
  respondedRequests ProfessionalRequest[]

  // Phase 32C PR4d: conversation participation as a professional-side seat.
  conversationParticipations ConversationParticipant[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

