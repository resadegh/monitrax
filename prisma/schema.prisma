  storagePath     String // Key/path in storage
  storageUrl      String? // External URL for Google Drive etc.
  fileContent     Bytes? // File content for database storage (Monitrax provider)

  // Phase 50 D.1 — document-level dedup. SHA-256 of the file bytes, set at
