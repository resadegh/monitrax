// =============================================================================
// PHASE 13: TRANSACTIONAL INTELLIGENCE ENUMS
// =============================================================================

enum TransactionSource {
  BANK // Bank feed integration
  BASIQ // Basiq open banking integration
  CSV // CSV import
  QIF // QIF file import (MYOB/Quicken)
  OFX // OFX/QFX file import
  MANUAL // Manual entry
  // Phase 42 PR3 — receipts / invoices that did NOT match an existing
  // bank/QIF transaction. The DME analyze/confirm flow attempts a fuzzy
  // match against existing rows first (lib/bookkeeping/receiptMatcher.ts);
  // only when no candidate beats the threshold do we synthesise a row
  // here. Cash-quick-add transactions stay on `MANUAL` (different intent).
  RECEIPT
}

enum RecurrencePattern {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  IRREGULAR
}

enum AnomalyType {
  DUPLICATE // Possible duplicate transaction
  UNUSUAL_AMOUNT // Amount significantly differs from pattern
  NEW_MERCHANT // First time seeing this merchant
  PRICE_INCREASE // Recurring payment increased
  UNEXPECTED_CATEGORY // Category doesn't match merchant history
  TIMING_ANOMALY // Transaction at unusual time/day
}

// Phase 29: Expense Match Status for Recurring Payments
enum ExpenseMatchStatus {
  UNMATCHED // No expense linked, no suggestions
  SUGGESTED // AI found a potential match
  LINKED // User confirmed link to expense
  DISMISSED // User dismissed match suggestion
  CREATED // Expense was created from this recurring payment
}

// Phase 21.5 Tier 2 — user action on a projected reminder.
enum ReminderStatus {
  SNOOZED // Hidden until snoozedUntil passes, then re-surfaces
  DISMISSED // Hidden for this due-date cycle (re-surfaces when the renewal rolls over)
  DONE // Marked handled for this due-date cycle (re-surfaces next cycle)
}

// =============================================================================
// PHASE 13: UNIFIED TRANSACTION RECORD (UTR)
// =============================================================================

model UnifiedTransaction {
  id        String @id @default(uuid())
  userId    String
  accountId String

  // Core transaction data
  date      DateTime
  postDate  DateTime? // Settlement date
  amount    Float
  currency  String               @default("AUD")
  direction TransactionDirection

  // Merchant data
  merchantRaw          String? // Original merchant string from source
  merchantStandardised String? // Normalised merchant name
  merchantCategoryCode String? // MCC code if available
  description          String // Transaction description

  // Category hierarchy (AI + rules populated)
  categoryLevel1 String? // Top-level: "Food & Dining"
  categoryLevel2 String? // Sub-category: "Groceries"
  subcategory    String? // Detailed: "Supermarket"

  // User interaction
  tags                  String[] // User/system tags
  userCorrectedCategory Boolean  @default(false)
  confidenceScore       Float? // AI categorisation confidence (0-1)

  // Recurring detection
  isRecurring       Boolean            @default(false)
  recurrencePattern RecurrencePattern?
  recurrenceGroupId String? // Links recurring transactions together

  // Essential expense tracking (independent of recurring)
  isEssential Boolean @default(false) // Is this an essential expense?

  // Transfer tracking (internal transfers between accounts)
  isTransfer          Boolean @default(false) // Is this a transfer between accounts?
  transferToAccountId String? // Target account for transfers

  // Investment contribution tracking (money going into investment accounts)
  isInvestmentContribution Boolean @default(false) // Is this an investment contribution?
  investmentTransactionId  String? @unique // Links to the InvestmentTransaction created

  // Anomaly detection
  anomalyFlags AnomalyType[]

  // Source tracking
  source             TransactionSource @default(MANUAL)
  externalId         String? // ID from external source (bank, CSV row)
  basiqTransactionId String?           @unique // Basiq transaction ID (for deduplication)
  importBatchId      String? // Batch ID for grouped imports

  // Entity linking (GRDCS compatible)
  propertyId          String?
  loanId              String?
  incomeId            String?
  expenseId           String?
  investmentAccountId String?

  // Phase 42 PR1 — Cross-batch dedup foundation. Deterministic hash of the
  // normalised description, computed at write-time. Used to spot duplicates
  // when a user re-imports an overlapping QIF / CSV / OFX file. Nullable
  // because BASIQ rows have their own canonical key (`basiqTransactionId`)
  // and don't need the hash. See `lib/bookkeeping/normaliseDescription.ts`.
  normalisedDescriptionHash String?

  // Phase 42 PR3 — direct pointer to the matching Document (receipt /
  // invoice) when one exists. Set by the DME analyze/confirm flow:
  //   - Fuzzy-match against existing tx → set on the matched row, no
  //     parallel record is created
  //   - No match → a new RECEIPT-sourced row is created with this set
  //     to the document id
  // Querying this column is the canonical "show me the receipt for this
  // transaction" lookup; the existing many-to-many `DocumentLink` table
  // remains for general document↔entity linking.
  matchedDocumentId String?

  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime? // When TIE last processed this

  // Relationships
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account            @relation("UnifiedTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  // Phase 42 PR2 — Splits. The parent transaction's `categoryLevel*`
  // fields remain populated for backwards-compat (= the dominant split's
  // category, computed deterministically); per-line categories live on
  // `TransactionSplit` rows. Sum-of-splits MUST equal `amount` ± $0.01
  // — enforced by `lib/bookkeeping/splits.ts` at every mutation path.
  splits  TransactionSplit[]

  @@index([userId])
  @@index([accountId])
  @@index([date])
  @@index([merchantStandardised])
  @@index([categoryLevel1])
  @@index([isRecurring])
  @@index([recurrenceGroupId])
  @@index([source])
  @@index([processedAt])
  // Phase 42 PR1 — partial dedup index. Non-unique at v1 (existing prod
  // rows may already contain duplicates from pre-PR1 imports). The dedup
  // *check* lives at the API layer in `lib/bookkeeping/normaliseDescription.ts`.
  // Phase 42 PR1.1 will promote this to UNIQUE once a one-time audit + dedup
  // pass has been run against prod (CLAUDE.md §12.11 — destructive operations
  // need explicit user confirmation; we don't ship a unique constraint that
  // could fail the migration on production data without the audit pass).
  @@index([accountId, date, amount, normalisedDescriptionHash], name: "ut_dedup_qif_csv_ofx")
  @@map("unified_transactions")
}

// =============================================================================
// PHASE 13: MERCHANT MAPPING (Learning from corrections)
// =============================================================================

model MerchantMapping {
  id     String  @id @default(uuid())
  userId String? // Null = global mapping, set = user-specific

  // Merchant identification
  merchantRaw          String // Original merchant string pattern
  merchantStandardised String // Normalised name
  merchantCategoryCode String? // MCC if known

  // Category mapping
  categoryLevel1   String
  categoryLevel2   String?
  subcategory      String?
  customCategoryId String? // Reference to user's custom Category if used

  // Essential/Recurring flags (Phase 29)
  isEssential        Boolean @default(false)
  isRecurring        Boolean @default(false)
  suggestedFrequency String? // WEEKLY, FORTNIGHTLY, MONTHLY, etc.

  // Learning metadata
  confidence          Float  @default(1.0) // How confident this mapping is
  source              String @default("RULE") // RULE, USER, AI
  usageCount          Int    @default(0) // How many times applied
  userCorrectionCount Int    @default(0) // Number of user corrections

  // AI Learning context (Phase 29)
  aiConfidence    Float? // Last AI confidence for this merchant
  lastAIContext   String? // Context that led to AI suggestion
  lastConfirmedAt DateTime? // When user last confirmed this mapping

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, merchantRaw])
  @@index([merchantRaw])
  @@index([userId])
  @@index([confidence])
  @@map("merchant_mappings")
}

// =============================================================================
// PHASE 42 PR1: CONSUMER BOOKKEEPING FOUNDATION
//
// Three additive models supporting Phase 42 — Consumer Bookkeeping
// Completion (XERO-Complementary). Spec lives at
// docs/blueprint/PHASE_42_CONSUMER_BOOKKEEPING_COMPLETION.md.
//
// CanonicalCategoryRegistry — single SSOT for category labels across
// UnifiedTransaction strings + Expense.customCategoryId + MerchantMapping.
// BASIQ-fed and QIF-fed categorisations both resolve through this surface
// (CLAUDE.md §12.2 SSOT). PR2+ will add the level1/2/sub → registry-id
// resolver helpers; PR1 ships the table + a backfill that seeds entries
// from the existing distinct (categoryLevel1, categoryLevel2, subcategory)
// triples on UnifiedTransaction.
//
// BookkeepingPeriod — psychological milestone, NOT a statutory close
// (Xero remains the accountant tool). Three-status state machine
// OPEN → REVIEWED → LOCKED; LOCKED is opt-in (rare, when handing the
// tax pack to the accountant). Edits are blocked at the API layer ONLY
// when status=LOCKED. See also TaxPack export (PR5).
//
// TransactionEdit — per-mutation audit trail. Every category / split /
// link / flag mutation through the UnifiedTransaction PATCH path writes
// a row here. Used for AFSL/TPB compliance trail when a professional
// reviews a client (Phase 32B PR3 already audits the *read*; this
// audits the *write*).
// =============================================================================

enum BookkeepingPeriodStatus {
  OPEN // Current / past month; no review yet
  REVIEWED // User confirmed all transactions categorised; edits still allowed
  LOCKED // User explicitly locked (rare); edits blocked at API
}

model CanonicalCategoryRegistry {
  id               String       @id @default(uuid())
  userId           String
  level1           String // Top-level: "Food & Dining"
  level2           String? // Sub-category: "Groceries"
  subcategory      String? // Detailed: "Supermarket"
  // EXPENSE | INCOME — Transfers map to EXPENSE here; the level1 string
  // ("Transfer") preserves the identity. PR2+ may extend the enum if
  // downstream calc engines need to distinguish three-way.
  type             CategoryType
  isSystem         Boolean      @default(false)
  // Optional bridge to a user-renamed Category (Phase 13 model). When set,
  // the user's preferred display name lives there; the level1/2/sub triple
  // is the canonical machine identity. PR2+ will keep them in sync.
  customCategoryId String?
  isActive         Boolean      @default(true)
  // Reserved for PR5 — bridge to TaxCategoryMapping. Kept nullable in PR1
  // so the column exists and PR5's migration is purely additive.
  taxCategoryId    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Phase 42 PR2 — back-relation to splits that reference this category.
  splits         TransactionSplit[]
  // Phase 42 PR5 — back-relations to Vendor.defaultCategoryId +
  // TaxCategoryMapping.canonicalCategoryId.
  vendorDefaults Vendor[]
  taxMappings    TaxCategoryMapping[]

  @@unique([userId, level1, level2, subcategory])
  @@index([userId])
  @@index([userId, type])
  @@map("canonical_category_registry")
}

model BookkeepingPeriod {
  id                       String                  @id @default(uuid())
  userId                   String
  // First day of the month, normalised to UTC midnight. Uniqueness is
  // enforced on (userId, periodMonth).
  periodMonth              DateTime
  status                   BookkeepingPeriodStatus @default(OPEN)
  reviewedAt               DateTime?
  reviewedTransactionCount Int                     @default(0)
  totalTransactionCount    Int                     @default(0)
  lockedAt                 DateTime?
  notes                    String?                 @db.Text
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodMonth])
  @@index([userId, status])
  @@map("bookkeeping_periods")
}

// =============================================================================
// PHASE 42 PR6: ENGAGEMENT STATE
//
// Per-user state for the engagement layer (Daily Pulse, streak,
// completion celebration). Per Reza directive 2026-05-08:
//
//   "The user has to be engaged emotionally and mentally to perform
//    the categorisation tasks — not a chore."
//
// This row is the canonical home for the streak counter (Duolingo-
// style with shield mechanic — one missed day per 7-day window
// doesn't break the streak; psychology-of-habits mitigation against
// all-or-nothing collapse). Also tracks the last completion-celebration
// timestamp so the once-per-day-max confetti rule has a concrete anchor.
//
// One row per user — `userId @unique`. The row is auto-created on
// first `getOrCreateEngagementState()` call by
// `lib/bookkeeping/engagement/streak.ts`.
// =============================================================================

model EngagementState {
  id                   String    @id @default(uuid())
  userId               String    @unique
  // Current streak (consecutive days with ≥1 categorisation activity).
  // Activity counts in a rolling 24h window, not strict calendar day —
  // matches the engagement spec §6.4 "earn a day" rule.
  currentStreak        Int       @default(0)
  // All-time best streak. Never decreases (used for celebration copy
  // like "new personal best!").
  longestStreak        Int       @default(0)
  // UTC midnight of the day the user last touched the streak. Used to
  // compute whether today's activity extends, breaks, or burns a shield.
  lastActiveDate       DateTime?
  // Most recent date the shield was used (within the rolling 7-day
  // window). One shield per 7-day window; resets when the cycle rolls
  // forward. Null = no shield used yet OR the last shield is older
  // than 7 days.
  lastShieldUsedAt     DateTime?
  // Most recent completion-celebration timestamp. Used to enforce the
  // "confetti once per day max" rule per spec §6.5 — scarcity
  // preserves the delight.
  lastCelebrationAt    DateTime?
  // Rolling counters useful for personal-best copy. Updated when the
  // current streak ends and a new one begins.
  totalCategorisations Int       @default(0)

  // Phase 42 PR6.5b — Pending-actions popup gate. Shown once per calendar
  // day on the first dashboard render. Dismiss = "not today" (still shows
  // tomorrow). Opt-out = global off-switch (user can re-enable in settings
  // later). Per Reza idea 2026-05-07.
  lastPromptShownAt     DateTime?
  lastPromptDismissedAt DateTime?
  promptOptedOut        Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("engagement_state")
}

model TransactionEdit {
  id            String   @id @default(uuid())
  transactionId String
  userId        String
  editType      String // CATEGORY / TAGS / LINK_ENTITY / FLAG / RECURRING / DELETE
  // Snapshot of the changed fields BEFORE and AFTER. JSON keeps the schema
  // flexible as we add new editable fields in PR2-6 (splits, vendor, etc.).
  before        Json
  after         Json
  source        String // USER / AI / RULE / IMPORT / SYSTEM
  editedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([userId, editedAt])
  @@map("transaction_edits")
}

// =============================================================================
// PHASE 42 PR2: TRANSACTION SPLIT
//
// One row per per-line split of a UnifiedTransaction.amount. The sum of
// all splits for a transaction MUST equal `transaction.amount` ± $0.01
// (validation lives in `lib/bookkeeping/splits.ts:assertSplitsBalance`).
//
// Backwards-compat rule: when splits exist, the parent transaction's
// `categoryLevel*` fields hold the **dominant** split's category
// (largest absolute amount; ties broken by createdAt). All canonical
// engines (`getMasterFinancialSnapshot`, expense/income aggregators,
// `lib/utils/reconciliation`) keep reading the parent's category — they
// don't need to know about splits at v1. Splits are an additive layer
// for users who want per-line precision (Bunnings: $200 deductible
// tools + $40 personal items, recorded honestly).
//
// QIF parser already extracts `S`/`$` split fields per
// `lib/bank/parsers/qif.ts` — PR2 wires them into rows here at import time.
//
// `categoryId` is a hard FK to `CanonicalCategoryRegistry` — the SSOT
// for category labels (CLAUDE.md §12.2). Per-line tax-deductibility
// inherits from the registry's `taxCategoryId` bridge (PR5) by default
// but can be overridden per-split.
// =============================================================================

model TransactionSplit {
  id              String   @id @default(uuid())
  transactionId   String
  // Hard FK to the SSOT registry. Resolves through
  // `lib/bookkeeping/categoryRegistry.ts:resolveOrCreateCategory()`.
  categoryId      String
  amount          Float // Same currency + sign convention as parent
  // Per-line entity attribution. Lets a single Bunnings purchase split
  // its receipts across "investment property" + "personal" without
  // duplicating the bank charge.
  propertyId      String?
  loanId          String?
  expenseId       String?
  isTaxDeductible Boolean  @default(false)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transaction UnifiedTransaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    CanonicalCategoryRegistry @relation(fields: [categoryId], references: [id])

  @@index([transactionId])
  @@index([categoryId])
  @@index([propertyId])
  @@index([expenseId])
  @@map("transaction_splits")
}

// =============================================================================
// PHASE 42 PR5: VENDOR + TAX CATEGORY MAPPING
//
// Two additive models. NEITHER replaces existing canonical surfaces:
//
// `Vendor` — consumer-side merchant card (annual totals, contracts,
// cancel link). Promoted from `MerchantMapping` per spec §3 D-42-5.
// MerchantMapping STAYS — it's the AI-learning surface (categorisation
// confidence, correction count); Vendor is the user-facing entity.
// Hard rule: NOT an AP master (no payment terms, no AP cycle, no
// invoice tracking). If it would appear in a Xero AP report, it's
// not a Vendor field.
//
// `TaxCategoryMapping` — bridge between Monitrax canonical categories
// (`CanonicalCategoryRegistry`) and ATO labels (D-1, D-5, Rental
// Schedule line items, Div 40 / Div 43 etc.). Used by the Phase 42
// Tax Pack export to group transactions under ATO labels — the
// accountant gets a CSV with ATO labels as columns; Monitrax's job
// stops there (the accountant decides deductibility per
// `PHASE_42_CONSUMER_BOOKKEEPING_COMPLETION.md` §1 hard rule).
// =============================================================================

model Vendor {
  id                     String   @id @default(uuid())
  userId                 String
  name                   String
  // Lowercased, alphanumeric-collapsed — same shape as
  // `lib/bookkeeping/normaliseDescription.ts`. Unique per user so
  // `lookupVendor()` is O(1) on the merchant string.
  normalisedName         String
  // ISO 18245 code from `lib/bank/mccCatalog.ts` if known. Optional —
  // many user-created vendors won't have one.
  mcc                    String?
  abn                    String?
  // Default category for new transactions matching this vendor. FK
  // to `canonical_category_registry` (the Phase 42 PR1 SSOT).
  defaultCategoryId      String?
  defaultIsTaxDeductible Boolean  @default(false)
  // Suggested frequency for recurring detection — same shape as
  // `RecurrencePattern` enum used elsewhere; kept as a plain string
  // here so the Vendor can hold "IRREGULAR" or future values without
  // a schema bump.
  suggestedFrequency     String?
  websiteUrl             String?
  // Deep-link to the merchant's account/cancellation page. PR6's
  // engagement layer surfaces this as a one-tap "Manage subscription"
  // affordance on the recurring-payment cards.
  cancelUrl              String?
  // Optional FK to a Document — the user's contract / PDS / lease.
  // SetNull on document delete (the Vendor outlives the doc).
  contractDocumentId     String?
  notes                  String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCategory CanonicalCategoryRegistry? @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)

  @@unique([userId, normalisedName])
  @@index([userId])
  @@index([userId, mcc])
  @@map("vendors")
}

model TaxCategoryMapping {
  id                  String   @id @default(uuid())
  // NULL = system-seeded (the ~60 default AU mappings). User overrides
  // create a row with their userId set.
  userId              String?
  // FK to the SSOT category registry. The mapping is an enrichment
  // ON TOP OF the registry — it doesn't replace it.
  canonicalCategoryId String
  atoLabel            String // e.g. "D-1", "Rental Repairs", "Div 40 Depreciation"
  schedule            String? // e.g. "Individual Tax Return", "Rental Schedule"
  lineItem            String? // ATO line number where applicable
  notes               String?
  createdAt           DateTime @default(now())

  category CanonicalCategoryRegistry @relation(fields: [canonicalCategoryId], references: [id], onDelete: Cascade)
  user     User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalCategoryId, atoLabel])
  @@index([userId])
  @@index([atoLabel])
  @@index([canonicalCategoryId])
  @@map("tax_category_mapping")
}

// =============================================================================
// PHASE 13: RECURRING PAYMENT DETECTION
// =============================================================================

model RecurringPayment {
  id     String @id @default(uuid())
  userId String

  // Identification
  merchantStandardised String
  accountId            String

  // Pattern
  pattern        RecurrencePattern
  expectedAmount Float
  amountVariance Float             @default(0.05) // 5% variance tolerance (ratio — stays Float)

  // Tracking
  lastOccurrence  DateTime
  nextExpected    DateTime?
  occurrenceCount Int       @default(0)

  // Alerts
  priceIncreaseAlert  Boolean   @default(false)
  lastPriceChange     Float?
  lastPriceChangeDate DateTime?

  // Status
  isActive Boolean @default(true)
  isPaused Boolean @default(false)

  // Phase 29: Expense Linking
  linkedExpenseId String? // Links to tracked expense
  matchConfidence Float? // Confidence score when matched (0-1)
  matchStatus     ExpenseMatchStatus @default(UNMATCHED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account  @relation("RecurringPayments", fields: [accountId], references: [id], onDelete: Cascade)
  linkedExpense Expense? @relation("RecurringPaymentExpense", fields: [linkedExpenseId], references: [id], onDelete: SetNull)

  @@unique([userId, merchantStandardised, accountId])
  @@index([userId])
  @@index([accountId])
  @@index([nextExpected])
  @@index([linkedExpenseId])
  @@map("recurring_payments")
}

/// Phase 21.5 Tier 2 — per-user snooze/dismiss/done state for projected reminders.
/// Keyed by the canonical engine's synthetic reminder id (`${entityId}:${sourceType}`).
/// ABSENCE of a row = ACTIVE (the default); a row exists only once the user has
/// acted on a reminder, so the table stays small. `dueDate` records the cycle the
/// action was taken against — the pure `applyReminderStates()` merge ignores a
/// state once the live reminder's dueDate has moved on (the renewal rolled over),
/// so a dismiss/done naturally resets each cycle and the reminder re-surfaces.
/// No financial / CDR data lives here — only a synthetic key + status + dates.
model ReminderState {
  id           String         @id @default(uuid())
  userId       String
  reminderKey  String // engine synthetic id: `${entityId}:${sourceType}`
  dueDate      DateTime // the due-date cycle this action applies to
  status       ReminderStatus
  snoozedUntil DateTime? // set only when status = SNOOZED
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reminderKey])
  @@index([userId])
  @@map("reminder_states")
}

/// Phase 21.5 R1 PR2b — user-created custom reminders ("remind me about X").
/// Projected into the unified feed by `computeCustomReminders`; the synthetic
/// id is `${id}:CUSTOM`, so snooze/dismiss/done state is shared with derived
/// reminders via `ReminderState` (no separate state machinery). No financial /
/// CDR data — a title, a due date, and a free-text note only (§13.3).
model Reminder {
  id        String   @id @default(uuid())
  userId    String
  title     String
  dueDate   DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reminders")
}

// =============================================================================
// PHASE R-CHARTS-2 (2026-05-30): NET WORTH HISTORICAL SNAPSHOTS
// =============================================================================
// Powers the editorial Net Worth Trend tile with HONEST data — replaces the
// prior simulated `generateNetWorthTrendData` (Math.random) used by the legacy
// NetWorthTrend component. One row per (user, month-anchor) — `snapshotDate`
// is the first day of the calendar month the row represents (UTC). The
// recorder upserts on every dashboard load so the current month always
// reflects the latest known position; once the calendar rolls over, the
// previous month freezes.
//
// Float is consistent with the rest of the financial schema (Property
// currentValue Float, Loan principal Float, Account currentBalance Float —
// this table is a derived aggregate of those values).
model NetWorthSnapshot {
  id               String   @id @default(uuid())
  userId           String
  /// First day of the calendar month this snapshot represents (UTC).
  /// Uniqueness on (userId, snapshotDate) makes the recorder upsert
  /// idempotent across multiple visits in the same month.
  snapshotDate     DateTime
  totalAssets      Float
  totalLiabilities Float
  netWorth         Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@index([userId])
  @@map("net_worth_snapshots")
}

// =============================================================================
// PHASE 13: BEHAVIOURAL PROFILE
// =============================================================================

model SpendingProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Category averages (JSON: { category: { avgMonthly, trend, volatility } })
  categoryAverages Json

  // Monthly patterns (JSON: { month: { totalSpend, categories } })
  monthlyPatterns Json?

  // Seasonality detection
  seasonalityFactors Json? // { category: { jan: 1.2, feb: 0.9, ... } }

  // Spending clusters (AI-detected patterns)
  spendingClusters Json? // [{ name, merchants, avgMonthly }]

  // Volatility metrics
  overallVolatility  Float @default(0)
  categoryVolatility Json? // { category: volatilityScore }

  // Prediction data
  predictedMonthlySpend Float?
  predictionConfidence  Float?

  // Metadata
  dataPointCount Int      @default(0)
  lastCalculated DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("spending_profiles")
}

// =============================================================================
// PHASE 14: CASHFLOW OPTIMISATION ENGINE ENUMS
// =============================================================================

enum CashflowInsightCategory {
  RECURRING // Recurring payment insights
  ANOMALY // Unusual spending detected
  INEFFICIENCY // Wasteful spending identified
  LIQUIDITY_RISK // Cash shortage risk
  SUBSCRIPTION // Subscription-related insight
  SAVINGS_OPPORTUNITY // Potential savings found
}

enum CashflowStrategyType {
  OPTIMISE // General optimisation
  PREVENT_SHORTFALL // Avoid cash shortage
  MAXIMISE_OFFSET // Maximise offset benefits
  REDUCE_WASTE // Cut wasteful spending
  REBALANCE // Rebalance cash allocation
  REPAYMENT_OPTIMISE // Optimise loan repayments
  SCHEDULE_OPTIMISE // Optimise payment scheduling
}

enum CashflowInsightSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// =============================================================================
// PHASE 11: AI STRATEGY ENGINE ENUMS
// =============================================================================

enum StrategyCategory {
  GROWTH
  DEBT
  CASHFLOW
  INVESTMENT
  PROPERTY
  RISK_RESILIENCE
}

enum StrategyType {
  TACTICAL // Immediate action
  OPERATIONAL // 3-12 months
  STRATEGIC // 1-5 years
  LONG_TERM // 5-30 years
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  DISMISSED
  EXPIRED
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum RiskAppetite {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

enum DebtComfort {
  DEBT_AVERSE
  MODERATE
  LEVERAGE_COMFORTABLE
}

enum InvestmentStyle {
  PASSIVE
  BALANCED
  ACTIVE
}

enum ScenarioType {
  DEFAULT
  CONSERVATIVE
  AGGRESSIVE
  CUSTOM
}

// =============================================================================
// PHASE 11: STRATEGY RECOMMENDATION
// =============================================================================

model StrategyRecommendation {
  id             String  @id @default(uuid())
  userId         String
  organizationId String?

  // Classification
  category StrategyCategory
  type     StrategyType
  severity String // 'critical' | 'high' | 'medium' | 'low' (from InsightSeverity)

  // Content
  title   String
  summary String @db.Text
  detail  String @db.Text

  // Scoring
  sbsScore   Float // Strategic Benefit Score (0-100)
  confidence ConfidenceLevel

  // Impact Analysis (stored as JSON for flexibility)
  financialImpact Json // { min, max, currency, timeframe, monthlySavings, totalSavings, breakEven }
  riskImpact      Json // { current, projected, factors[] }
  liquidityImpact Json? // { currentLiquidity, projectedLiquidity, impact }
  taxImpact       Json? // { currentTax, projectedTax, savings }

  // Evidence & Explainability
  reasoning      String   @db.Text // Step-by-step reasoning trace
  evidenceGraph  Json // { dataPoints[], historicalTrend[], snapshotValues, insightFlags[], healthIssues[], calculations }
  alternativeIds String[] // IDs of alternative strategies

  // Affected Entities (GRDCS format)
  affectedEntities Json // GRDCSLinkedEntity[] - entities impacted by this recommendation

  // Forecast Projection (optional)
  forecastData Json? // Multi-year projection if applicable

  // User Interaction
  status        RecommendationStatus @default(PENDING)
  dismissedAt   DateTime?
  acceptedAt    DateTime?
  dismissReason String?

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime? // When this recommendation becomes stale

  // Relationships
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId, status])
  @@index([organizationId])
  @@index([category, status])
  @@index([sbsScore])
  @@index([createdAt])
  @@map("strategy_recommendations")
}

// =============================================================================
// PHASE 11: STRATEGY SESSION (User Preferences)
// =============================================================================

model StrategySession {
  id     String @id @default(uuid())
  userId String

  version Int @default(1)

  // User Input Parameters
  riskAppetite    RiskAppetite?
  timeHorizon     Int? // Years (e.g., 5, 10, 20, 30)
  debtComfort     DebtComfort?
  investmentStyle InvestmentStyle?
  retirementAge   Int? // Target retirement age

  // Scenario Selection
  scenarioType     ScenarioType @default(DEFAULT)
  customParameters Json? // Custom forecast parameters if scenarioType = CUSTOM

  // Tracking
  acceptedCount  Int @default(0)
  dismissedCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("strategy_sessions")
}

// =============================================================================
// PHASE 11: STRATEGY FORECAST (Multi-Year Projections)
// =============================================================================

model StrategyForecast {
  id     String @id @default(uuid())
  userId String

  // Forecast Parameters
  startYear    Int // Starting year (e.g., 2025)
  endYear      Int // Ending year (e.g., 2055 for 30-year forecast)
  scenarioType ScenarioType

  // Input Assumptions
  incomeGrowthRate Float // Annual income growth rate (e.g., 0.03 for 3%)
  expenseInflation Float // Annual expense inflation (e.g., 0.025 for 2.5%)
  investmentReturn Float // Expected annual investment return (e.g., 0.07 for 7%)
  rentalYield      Float // Expected rental yield (e.g., 0.04 for 4%)
  cpiProjection    Float // CPI inflation projection (e.g., 0.025 for 2.5%)

  // Yearly Projections (array of year data stored as JSON)
  projections Json // [{ year, netWorth, debt, cashflow, income, expenses, investments, properties }]

  // Risk Bands (best/worst case scenarios)
  worstCase Json // Worst case projection array
  bestCase  Json // Best case projection array

  // Target Achievement
  targetProbability Float? // Probability of achieving retirement/goal target (0-1)

  createdAt DateTime @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scenarioType])
  @@index([createdAt])
  @@map("strategy_forecasts")
}

// =============================================================================
// PHASE 14: CASHFLOW FORECAST
// =============================================================================

model CashflowForecast {
  id        String  @id @default(uuid())
  userId    String
  accountId String? // Null = global forecast across all accounts

  // Forecast date
  date DateTime // The date this forecast is for

  // Predicted values
  predictedBalance  Float // Predicted balance on this date
  predictedIncome   Float // Predicted income for this date
  predictedExpenses Float // Predicted expenses for this date

  // Confidence metrics
  confidenceScore  Float // 0-1 confidence in this prediction
  volatilityFactor Float @default(0) // Volatility index (0 = stable)

  // Confidence bands (upper/lower bounds)
  upperBound Float? // Optimistic scenario
  lowerBound Float? // Pessimistic scenario

  // Additional metadata
  predictedRecurring    Float   @default(0) // Recurring payments expected
  predictedNonRecurring Float   @default(0) // Non-recurring expected
  shortfallRisk         Boolean @default(false) // Is shortfall predicted?
  shortfallAmount       Float? // Amount of predicted shortfall

  // Calculation metadata
  metadata Json? // { calculationMethod, inputCount, anomaliesDetected }

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId, date])
  @@index([userId])
  @@index([accountId])
  @@index([date])
  @@index([shortfallRisk])
  @@map("cashflow_forecasts")
}

