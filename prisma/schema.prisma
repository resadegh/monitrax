  LINE_OF_CREDIT // Revolving credit - can be linked to Account (e.g., credit card)
  STUDENT // Education/HECS-HELP debt
  BUSINESS // Business loan
}

enum RateType {
  VARIABLE
  FIXED
}

enum RepaymentFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum AccountType {
  OFFSET
  SAVINGS
  TRANSACTIONAL
  CREDIT_CARD
}

enum BalanceSource {
  MANUAL // User manually entered balance
  IMPORT // Balance from CSV/QIF/OFX import
  BASIQ // Balance from Open Banking (Basiq)
  USER_VERIFIED // User verified balance after import
}

// NOTE: `EntrySource` enum was removed as part of the 2026-04-15
// Phase 12 A.0 revert for prod safety. The production database
// was never migrated to include the `source` columns (no
// `_prisma_migrations` history on prod), so the generated Prisma
// client was crashing on every SELECT against accounts / properties
// / loans / income / expenses / investment_accounts / assets /
// superannuation_accounts / household_profiles. The enum + fields
// will be re-introduced once prod is baselined with Prisma and the
// A.0 migration runs in a maintenance window. See
// docs/quality/PHASE_12_DESIGN_AUDIT.md §11 (R12) and
// CLAUDE.md §12.11 for the destructive-write checklist that must
// ship alongside the re-introduction.

