// =============================================================================
// PHASE 20: SUPERANNUATION ACCOUNT
// =============================================================================

// Phase 39.5: distinguishes retail/industry super (member of an external
// APRA fund) from SMSF (a self-managed fund modelled as a LegalEntity that
// OWNS its assets). SMSF member balances carry ownerEntityId → the SMSF
// LegalEntity; their net worth flows through the entity's owned assets, so
// they are excluded from the super-bucket sum to avoid double-counting.
enum SuperFundType {
  INDUSTRY // Industry fund (AustralianSuper, Hostplus, …) — default
  RETAIL // Retail fund (employer/wrap MySuper, …)
  SMSF // Self-managed super fund — linked to a LegalEntity(type=SMSF)
}

model SuperannuationAccount {
  id     String @id @default(uuid())
  userId String

  // Phase 39.5: fund classification + SMSF entity link.
  // Phase 47 Stage B1 (Q-EOF-2, 2026-06-10): ownerEntityId is now set for
  // EVERY account — the SMSF LegalEntity for SMSF member accounts, the
  // member's PERSONAL_NAME entity for retail/industry (member-benefit
  // semantics). Backfilled by 20260610090000_backfill_super_owner_entity;
  // nullable retained for defensive null-handling only.
  fundType      SuperFundType @default(INDUSTRY)
  ownerEntityId String?

  // Account details
  name         String
  fundName     String?
  memberNumber String?
  fundABN      String?

  // Balances
  currentBalance   Float @default(0)
  taxableComponent Float @default(0)
  taxFreeComponent Float @default(0)

  // Contribution tracking (current FY)
  concessionalYTD    Float   @default(0) // SG + Salary Sacrifice + Personal deductible
  nonConcessionalYTD Float   @default(0) // After-tax contributions
  financialYear      String? // e.g., "2024-25"

  // Contribution caps (updated annually)
  concessionalCap    Float @default(27500)
  nonConcessionalCap Float @default(110000)

  // Carry-forward tracking (unused concessional caps from prior 5 years)
  carryForwardAvailable Float @default(0)

  // Investment options / performance (optional)
  investmentOption String?
  returns1Year     Float?
  returns5Year     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerEntity   LegalEntity?        @relation(fields: [ownerEntityId], references: [id], onDelete: SetNull)
  contributions SuperContribution[]

  @@index([userId])
  @@index([ownerEntityId])
  @@map("superannuation_accounts")
}

// Phase 44.2: the SMSF's declared annual fund-level figures for one FY —
// the persisted input to `calculateSmsfIncomeTax` (Div 295 / ECPI / NALI).
// Keyed per (SMSF LegalEntity, financial year). `assembleEntityTaxFacts`
// reads this to populate `facts.smsfIncomeTax` so the GET entity-tax path
// returns a real number instead of UNCOMPUTED. These are an ESTIMATE input,
// never tax advice — surfaced with the canonical boundary footnote.
// `ecpiExemptProportion` null = unknown → the engine returns the
// investment-income tax as UNCOMPUTED (never estimated).
model SmsfAnnualReturn {
  id            String @id @default(uuid())
  userId        String
  legalEntityId String
  financialYear String // e.g. "2024-25"

  assessableInvestmentIncome Float   @default(0) // ordinary + statutory investment income (ex-contributions/NALI)
  deductions                 Float   @default(0) // deductions against investment income
  assessableContributions    Float   @default(0) // employer SG + salary sacrifice + personal deductible (taxed @15%)
  nonArmsLengthIncome        Float   @default(0) // NALI — taxed at top rate, ECPI never applies (s295-550)
  frankingCredits            Float   @default(0) // Phase 44.2 slice 2: refundable imputation credits (Div 207 + s67-25)
  isComplying                Boolean @default(true)
  isInPensionPhase           Boolean @default(false)
  ecpiExemptProportion       Float? // 0..1 exempt proportion; null = unknown (drives UNCOMPUTED) — ratio stays Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@unique([legalEntityId, financialYear])
  @@index([userId])
  @@map("smsf_annual_returns")
}

