// PHASE 10: AUTH & SECURITY ENUMS
// =============================================================================

enum MFAType {
  TOTP // Google Authenticator, Authy
  SMS // SMS fallback
  WEBAUTHN // FIDO2, Passkeys, hardware keys
}

enum AuditAction {
  // Auth
  LOGIN
  LOGOUT
  REGISTER
  MFA_CHALLENGE
  MFA_SUCCESS
  MFA_FAILURE
  PASSWORD_CHANGE
  PASSWORD_RESET
  EMAIL_VERIFIED
  OAUTH_LOGIN

  // Passkey / WebAuthn
  PASSKEY_REGISTER
  PASSKEY_UPDATE
  PASSKEY_DELETE

  // CRUD operations
  CREATE
  READ
  UPDATE
  DELETE

  // Special operations
  EXPORT
  BULK_DELETE
  API_REQUEST

  // Admin operations
  ROLE_CHANGE
  ORG_MEMBER_ADD
  ORG_MEMBER_REMOVE
  ORG_SETTINGS_UPDATE
  SESSION_REVOKE
  ACCOUNT_LOCK
  ACCOUNT_UNLOCK
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED

  // Security
  RATE_LIMIT_HIT
  UNAUTHORIZED_ACCESS
  FORBIDDEN_ACCESS

  // CDR Data Lifecycle (Phase 35 — Basiq §5.4, §5.5, §5.6)
  CDR_DATA_DELETED
  CDR_CONSENT_EXPIRED
  CDR_CONSENT_REVOKED
  CDR_DATA_ANONYMIZED

  // Phase 32B PR3 — B2B2C drill-in (canonical consumer dashboard rendered
  // through a professional viewer context). Per-view detail also lands in
  // ClientAccessLog; this top-level row makes the access discoverable from
  // the user's audit trail too.
  PRO_DASHBOARD_VIEW

  // Phase 32C PR4a — Professional marketplace listing lifecycle. Org-side
  // events (UPDATED / SUBMITTED) sit on the Org's audit log; admin-side
  // events (APPROVED / REJECTED / SUSPENDED) sit on the Monitrax admin's
  // audit log via AdminAuditLog. Listed here together for grep-ability.
  MARKETPLACE_LISTING_UPDATED
  MARKETPLACE_LISTING_SUBMITTED
  MARKETPLACE_LISTING_APPROVED
  MARKETPLACE_LISTING_REJECTED
  MARKETPLACE_LISTING_SUSPENDED

  // Phase 32C PR4c — Professional request lifecycle (D2C user → marketplace
  // listing → adviser inbox → ACCEPTED / DECLINED). On ACCEPTED, an
  // OrganizationClient row is created (consent invite path) and a
  // lead-fee billing intent is recorded — actual Stripe charge wires in PR6.
  PROFESSIONAL_REQUEST_SUBMITTED
  PROFESSIONAL_REQUEST_ACCEPTED
  PROFESSIONAL_REQUEST_DECLINED
  PROFESSIONAL_REQUEST_WITHDRAWN
  PROFESSIONAL_REQUEST_EXPIRED

  // Phase 33g — Adviser feedback inbox. Every reply (from either side),
  // every status flip, and every internal-note edit writes one of these.
  // CLAUDE.md §13.3 "audit everything"; §16.3 row "Strategic decision".
  FEEDBACK_THREAD_REPLIED
  FEEDBACK_THREAD_STATUS_CHANGED
  FEEDBACK_INTERNAL_NOTE_UPDATED

  // Phase 32C PR4d — In-app conversations + email-through-app between
  // a consumer and a professional. Auto-created when a ProfessionalRequest
  // is ACCEPTED; persisted with 7-yr retention for the professional's
  // AFSL compliance archive (decision 2026-05-04). Soft-delete from the
  // user view does NOT remove the row — the message stays in the archive.
  CONVERSATION_CREATED
  CONVERSATION_MESSAGE_SENT
  CONVERSATION_EMAIL_OUTBOUND
  CONVERSATION_EMAIL_INBOUND
  CONVERSATION_SOFT_DELETED_FROM_USER

  // Phase 32C PR6 — Stripe billing lifecycle. Webhook handlers fire these
  // when subscription state changes. Test-mode events at v1; live mode
  // events ship post-Basiq accreditation.
  BILLING_CHECKOUT_STARTED
  BILLING_SUBSCRIPTION_CREATED
  BILLING_SUBSCRIPTION_UPDATED
  BILLING_SUBSCRIPTION_CANCELLED
  BILLING_INVOICE_PAID
  BILLING_INVOICE_FAILED
  BILLING_WEBHOOK_RECEIVED
}

enum AuditStatus {
  SUCCESS
  FAILURE
  BLOCKED
}

// =============================================================================
// PHASE 20: AUSTRALIAN TAX INTELLIGENCE ENGINE ENUMS
// =============================================================================

enum SalaryType {
  GROSS // Before tax
  NET // After tax (take-home)
}

enum PayFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum TaxCategory {
  // Employment Income
  SALARY_WAGES // Fully taxable
  ALLOWANCES // Taxable unless specific exemptions
  BONUSES // Fully taxable
  TERMINATION // Special tax treatment

  // Investment Income
  DIVIDENDS_FRANKED // Taxable with franking credits
  DIVIDENDS_UNFRANKED // Fully taxable
  INTEREST // Fully taxable
  CAPITAL_GAINS // CGT rules apply

  // Property Income
  RENTAL // Fully taxable

  // Government Payments
  GOVERNMENT_TAXABLE // Most are taxable
  GOVERNMENT_EXEMPT // Some are exempt

  // Other
  GIFTS // Generally exempt
  INHERITANCE // Generally exempt
  INSURANCE_PAYOUT // Generally exempt
  HOBBY_INCOME // May be taxable if profit-making

  // Exempt
  TAX_EXEMPT // Confirmed exempt
}

enum SuperContributionType {
  EMPLOYER_SG // Super Guarantee (mandatory)
  SALARY_SACRIFICE // Pre-tax voluntary
  PERSONAL_DEDUCTIBLE // Personal contribution claiming deduction
  PERSONAL_NON_DEDUCT // After-tax personal contribution
  SPOUSE // Spouse contribution
  GOVERNMENT_COCONTRIB // Government co-contribution
  DOWNSIZER // Downsizer contribution (65+)
}

// =============================================================================
// PHASE 41: LEGAL ENTITY (Entity Layer foundation)
// =============================================================================

// `LegalEntityType` — the structural form a wealth-holding vehicle takes.
// Forced at registration via the onboarding wizard (Phase 41b). The full
// taxonomy is intentionally narrow at v1; uncommon shapes (foreign trusts,
// bare trusts, etc.) escalate to OTHER-style support requests until demand
// proves out. See `docs/architecture/03_DATA_MODEL.md` §10.
enum LegalEntityType {
  PERSONAL_NAME // Default — assets held in a natural person's own name
  COMPANY // Pty Ltd / Ltd
  DISCRETIONARY_TRUST // Family discretionary trust (most common AU structure)
  UNIT_TRUST // Fixed-unit trust
  SMSF // Self-Managed Super Fund (regulated by ATO)
  PARTNERSHIP // General or limited partnership
  SOLE_TRADER // ABN-registered individual operating a business
}

// `LegalEntityRole` — the *purpose* of the entity in the user's wealth picture.
// One person + multiple entities is normal: PERSONAL (natural name) +
// HOLDING (family trust holds investments) + OPERATING (Pty Ltd runs a
// business) + SUPERANNUATION (SMSF). Drives Phase 41c entity-tree colour and
// Phase 41h AI advisor framing.
enum LegalEntityRole {
  HOLDING // Holds passive investments (most common for trusts)
  OPERATING // Runs an active business (most common for Pty Ltd / sole traders)
  INVESTMENT // Investment-only vehicle (e.g. unit trust used as a property syndicate)
  SUPERANNUATION // SMSF — superannuation only
  PERSONAL // Natural person ownership (default for every existing user)
}

// `LegalEntity` — the foundational ownership object for the Phase 41 entity
// layer. Every Property / Loan / Account / InvestmentAccount / Asset / Income /
// Expense will hang off a `LegalEntity` via `ownerEntityId` (instead of the
// flat `userId` it lives on today). The migration backfills every existing
// user with a single `PERSONAL_NAME` entity and reassigns existing rows to
// it, so behaviour is preserved end-to-end before the wizard ships.
//
// TFN handling (CLAUDE.md §13):
//   - `tfnEncrypted` is OPTIONAL. Default-off — the user must explicitly
//     opt in via the wizard.
//   - At rest the field is base64-wrapped via `lib/security/tfnEncryption.ts`
//     (mirrors the `MFAMethod.secret` pattern). The helper is a single
//     swap-point for upgrading to KMS-backed CMEK encryption when CMEK lands
//     (queued in `IMPLEMENTATION_PLAN.md` Up Next #3).
//   - TFN MUST never be logged, MUST never appear in audit metadata (use
//     `sanitizeCdrMetadata()` if a tfn-bearing entity flows through audit
//     logging by accident), MUST never be sent to Gemini / any AI model.
//   - Read paths use `getTfnForUser(...)` which decrypts inside a single
//     authorisation boundary; the field is never returned via API
//     responses by default.
model LegalEntity {
  id              String          @id @default(uuid())
  userId          String
  name            String // Display name — "Smith Family Trust" / "Reza Sadeghi" / "Acme Pty Ltd"
  type            LegalEntityType
  role            LegalEntityRole
  abn             String? // 11-digit Australian Business Number (companies, trusts, partnerships, sole traders)
  acn             String? // 9-digit Australian Company Number (companies only)
  tfnEncrypted    String? // Encrypted at rest via lib/security/tfnEncryption.ts; never logged, never sent to AI
  tradingName     String? // Optional trading-as name distinct from legal name
  establishedDate DateTime? // Date the entity was formed (incorporation / trust deed execution / SMSF establishment)
  parentEntityId  String? // Self-FK for trustee → trust relationships (e.g. corporate trustee Pty Ltd is parent of the Family Trust)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relationships
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentEntity  LegalEntity?  @relation("EntityHierarchy", fields: [parentEntityId], references: [id], onDelete: SetNull)
  childEntities LegalEntity[] @relation("EntityHierarchy")

  // Reverse owner relations (every owned object hangs back here)
  properties         Property[]
  loans              Loan[]
  accounts           Account[]
  investmentAccounts InvestmentAccount[]
  assets             Asset[]
  incomes            Income[]
  expenses           Expense[]

  @@index([userId])
  @@index([type])
  @@index([parentEntityId])
  @@map("legal_entities")
}

// =============================================================================
// USER
// =============================================================================

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String? // Nullable for passwordless accounts
  name               String
  role               UserRole  @default(OWNER)
  emailVerified      Boolean   @default(false)
  emailVerifiedAt    DateTime?
  mfaEnabled         Boolean   @default(false)
  mfaEnforcedByOrg   Boolean   @default(false)
  accountLocked      Boolean   @default(false)
  accountLockedUntil DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Phase 12: Onboarding fields
  onboardingCompleted   Boolean                @default(false)
  onboardingProfileType OnboardingProfileType?
  onboardingStartedAt   DateTime?
  onboardingCompletedAt DateTime?
  onboardingStep        Int                    @default(0) // Current wizard step (0-7)

  // Basiq Open Banking Integration
  basiqUserId String? @unique // Basiq user ID for this user

  // Profile Information
  mobile   String? // Australian mobile number for bank verification
  phone    String? // General phone number
  location String? // City/State
  timezone String? @default("Australia/Sydney")
  bio      String? // User bio/description

  // Relationships
  properties         Property[]
  loans              Loan[]
  accounts           Account[]
  income             Income[]
  expenses           Expense[]
  transactions       Transaction[]
  basiqConnections   BasiqConnection[] // Basiq Open Banking connections
  debtPlans          DebtPlan[]
  investmentAccounts InvestmentAccount[]
  assets             Asset[] // Phase 21: Personal assets

  // Phase 10: Auth & Security
  organizationMemberships OrganizationMember[]
  mfaMethods              MFAMethod[]
  sessions                UserSession[]
  auditLogs               AuditLog[]
  passkeyCredentials      PasskeyCredential[]
  magicLinks              MagicLink[]
  oauthAccounts           OAuthAccount[]
  loginAttempts           LoginAttempt[]
  emailMFACodes           EmailMFACode[]

  // Phase 11: AI Strategy Engine
  strategyRecommendations StrategyRecommendation[]
  strategySessions        StrategySession[]
  strategyForecasts       StrategyForecast[]

  // Phase 13: Transactional Intelligence
  unifiedTransactions UnifiedTransaction[]
  recurringPayments   RecurringPayment[]
  spendingProfile     SpendingProfile?

  // Phase 14: Cashflow Optimisation Engine
  cashflowForecasts  CashflowForecast[]
  cashflowInsights   CashflowInsight[]
  cashflowStrategies CashflowStrategy[]

  // Phase 18: Bank Transaction Import
  bankImportFiles BankImportFile[]
  budgetTargets   BudgetTarget[]

  // Phase 19: Document Management
  documents             Document[]
  storageProviderConfig StorageProviderConfig?

  // Phase 20: Australian Tax Intelligence Engine
  superannuationAccounts SuperannuationAccount[]
  taxPositions           TaxPosition[]

  // Phase 12: User Preferences
  userPreference UserPreference?

  // Phase 28: Realistic Budget Integration
  householdProfile HouseholdProfile?
  budgetAnalyses   BudgetAnalysis[]
  debtAnalyses     DebtAnalysis[]

  // Phase 29: Cashflow Intelligence Center
  cashflowSummaries CashflowSummary[]

  // Custom Categories
  categories Category[]

  // Phase 29: AI Categorisation & Learning
  aiCategorizationLearnings AICategorizationLearning[] @relation("AICategorizationLearnings")
  importBatches             ImportBatch[]              @relation("ImportBatches")
  transactionReviewQueue    TransactionReviewQueue[]   @relation("TransactionReviewQueue")

  // Phase L: CDR Compliance Models
  cdrConsents    CDRConsent[]
  cdrComplaints  CDRComplaint[]
  cdrDisclosures CDRDisclosure[]

  // Phase 38 PR 3: My Vault — Share Pass (accountant share-link, future
  // generic share engine for Reports / property summaries / net worth).
  sharePackages SharePackage[]

  // Phase 40: My Guide — AI Financial Advice (cached advice docs + chat).
  aiAdviceDocuments AIAdviceDocument[]

  // Phase 41: Entity Layer — every user has at least one LegalEntity (their
  // PERSONAL_NAME entity is created during onboarding and backfilled for
  // existing users by migration `20260504130000_add_legal_entity`).
  legalEntities LegalEntity[]

  // Phase 32C PR4a: Marketplace ratings — a user can rate a professional
  // listing they've engaged with (one rating per listing per user).
  professionalRatings ProfessionalRating[]

  // Phase 32C PR4c: requests this user has submitted to professional listings.
  professionalRequests ProfessionalRequest[]

  // Phase 33g: Adviser feedback inbox. A user can author feedback threads
  // (when they're an adviser hitting `/portal/feedback`) and reply to threads
  // as either the original adviser OR a Monitrax admin (when Reza replies
  // from `/admin/feedback`, the FeedbackMessage.authorRole disambiguates).
  feedbackThreads  FeedbackThread[]
  feedbackMessages FeedbackMessage[]

  // Phase 32C PR4d: conversations this user is a participant in (typically
  // one per ACCEPTED engagement). Includes both the consumer side (linked
  // via this relation) and any messages they've sent.
  conversationParticipations ConversationParticipant[]
  conversationMessages       ConversationMessage[]    @relation("ConversationMessageSender")

  @@map("users")
}

// =============================================================================
// CUSTOM CATEGORIES - User-defined expense and income categories
// =============================================================================

model Category {
  id          String       @id @default(uuid())
  userId      String
  name        String // Display name (e.g., "Pet Care", "Side Business")
  type        CategoryType // EXPENSE or INCOME
  code        String // Unique code for the category (e.g., "PET_CARE")
  description String? // Optional description
  color       String? // Optional hex color for UI (e.g., "#FF5733")
  icon        String? // Optional icon name (e.g., "paw", "briefcase")
  isSystem    Boolean      @default(false) // True for system-default categories
  isActive    Boolean      @default(true) // Allow soft-delete/deactivation
  sortOrder   Int          @default(0) // For custom ordering
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Phase 29: Link categories to household members/pets for personalized tracking
  householdMemberId String? // Links to a household member (e.g., "Reza's Salary")
  householdPetId    String? // Links to a household pet (e.g., "Fandogh Pet Insurance")

  // Relationships
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses        Expense[]        @relation("ExpenseCustomCategory")
  income          Income[]         @relation("IncomeCustomCategory")
  householdMember HouseholdMember? @relation("MemberLinkedCategories", fields: [householdMemberId], references: [id], onDelete: SetNull)
  householdPet    HouseholdPet?    @relation("PetLinkedCategories", fields: [householdPetId], references: [id], onDelete: SetNull)

  @@unique([userId, code]) // Each user can have unique category codes
  @@index([userId])
  @@index([userId, type])
  @@index([householdMemberId])
  @@index([householdPetId])
  @@map("categories")
}

// =============================================================================
// PHASE 12: USER PREFERENCES
// =============================================================================

model UserPreference {
  id     String @id @default(uuid())
  userId String @unique

  // Tour state
  hasSeenGuidedTour Boolean   @default(false)
  tourSkippedAt     DateTime?
  tourCompletedAt   DateTime?

  // Onboarding UI state
  dismissedOnboardingBadge Boolean @default(false)
  dismissedWelcomeModal    Boolean @default(false)

  // User preference settings
  preferredCurrency   String  @default("AUD")
  preferredDateFormat String  @default("DD/MM/YYYY")
  country             String  @default("AU")
  taxYear             String? // e.g. "2025-2026" (AU FY). Null until the user sets it.

  // Phase 12 PR 2: Onboarding wizard draft state.
  // Stores the in-progress WizardData blob so users can resume a partial
  // setup across devices. Cleared (set to null) when bulk-create succeeds.
  // Null for users who have either not started or already completed onboarding.
  onboardingDraft Json?

  // Notification preferences (Phase 10)
  emailWeeklyDigest   Boolean @default(true)
  emailMonthlyReport  Boolean @default(true)
  emailAlerts         Boolean @default(true)
  emailProductUpdates Boolean @default(false)
  pushCashflowAlerts  Boolean @default(false)
  pushSpendingAlerts  Boolean @default(false)
  pushGoalUpdates     Boolean @default(false)
  pushBillReminders   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// =============================================================================
// PROPERTY
// =============================================================================

model Property {
  id            String       @id @default(uuid())
  userId        String
  ownerEntityId String // Phase 41: which LegalEntity owns this property — backfilled to user's PERSONAL_NAME entity
  name          String
  type          PropertyType
  address       String?
  purchasePrice Float
  purchaseDate  DateTime
  currentValue  Float
  valuationDate DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Location data (Google Maps integration)
  latitude      Float? // Latitude coordinate
  longitude     Float? // Longitude coordinate
  googlePlaceId String? // Google Places API place_id
  suburb        String? // Suburb/locality
  state         String? // State (e.g., NSW, VIC)
  postcode      String? // Postal code

  // Relationships
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerEntity           LegalEntity            @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)
  loans                 Loan[]
  income                Income[]
  expenses              Expense[]
  depreciationSchedules DepreciationSchedule[]

  @@index([userId])
  @@index([ownerEntityId])
  @@map("properties")
}

// =============================================================================
// LOAN
// =============================================================================

model Loan {
  id                  String             @id @default(uuid())
  userId              String
  ownerEntityId       String // Phase 41: which LegalEntity owes this debt — backfilled to user's PERSONAL_NAME entity
  propertyId          String?
  offsetAccountId     String?            @unique
  linkedAssetId       String? // For CAR loans - link to vehicle asset
  linkedAccountId     String? // For LINE_OF_CREDIT - link to credit card/account
  name                String
  type                LoanType
  principal           Float // Current balance
  interestRateAnnual  Float // e.g., 0.0625 for 6.25%
  rateType            RateType
  fixedExpiry         DateTime? // When fixed rate expires
  isInterestOnly      Boolean            @default(false)
  termMonthsRemaining Int
  minRepayment        Float // Current required payment
  repaymentFrequency  RepaymentFrequency
  extraRepaymentCap   Float? // Annual cap for extra repayments on fixed loans
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relationships
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerEntity   LegalEntity    @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)
  property      Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  offsetAccount Account?       @relation(fields: [offsetAccountId], references: [id], onDelete: SetNull)
  linkedAsset   Asset?         @relation(fields: [linkedAssetId], references: [id], onDelete: SetNull)
  linkedAccount Account?       @relation("LoanLinkedAccount", fields: [linkedAccountId], references: [id], onDelete: SetNull)
  expenses      Expense[]
  debtPlanLoans DebtPlanLoan[]

  @@index([userId])
  @@index([ownerEntityId])
  @@index([propertyId])
  @@index([linkedAssetId])
  @@index([linkedAccountId])
  @@map("loans")
}

// =============================================================================
// ACCOUNT
// =============================================================================

model Account {
  id             String      @id @default(uuid())
  userId         String
  ownerEntityId  String // Phase 41: which LegalEntity owns this account — backfilled to user's PERSONAL_NAME entity
  name           String
  type           AccountType
  institution    String?
  currentBalance Float
  interestRate   Float? // Annual interest rate (e.g., 0.025 for 2.5%)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Balance Source Tracking
  balanceSource        BalanceSource @default(MANUAL) // Where the balance came from
  balanceLastUpdatedAt DateTime? // When balance was last updated
  lastImportedBalance  Float? // Balance from most recent import

  // Basiq Open Banking Integration
  basiqAccountId    String?   @unique // Basiq account ID (if linked via Open Banking)
  basiqConnectionId String? // Basiq connection ID
  basiqLastSynced   DateTime? // Last time data was synced from Basiq
  accountNumber     String? // Masked account number from bank
  bsb               String? // BSB (for AU banks)

  // Relationships
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerEntity     LegalEntity      @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)
  basiqConnection BasiqConnection? @relation(fields: [basiqConnectionId], references: [id], onDelete: SetNull)
  transactions    Transaction[]
  linkedLoan      Loan? // One-to-one: this account can be an offset for one loan
  creditLineLoans Loan[]           @relation("LoanLinkedAccount") // LINE_OF_CREDIT loans linked to this account

  // Phase 13: Transactional Intelligence
  unifiedTransactions UnifiedTransaction[] @relation("UnifiedTransactions")
  recurringPayments   RecurringPayment[]   @relation("RecurringPayments")

  // Phase 14: Cashflow Optimisation Engine
  cashflowForecasts CashflowForecast[]

  // Phase 29: AI Categorisation & Import Batches
  importBatches ImportBatch[] @relation("ImportBatches")

  @@index([userId])
  @@index([ownerEntityId])
  @@index([basiqConnectionId])
  @@map("accounts")
}

// =============================================================================
// BASIQ CONNECTION (Open Banking)
// =============================================================================

enum BasiqConnectionStatus {
  ACTIVE // Connection is active and syncing
  PENDING // Awaiting user consent
  RECONNECT // Needs re-authentication
  DISABLED // User disabled this connection
  ERROR // Connection error
}

model BasiqConnection {
  id                String                @id @default(uuid())
  userId            String
  basiqConnectionId String                @unique // Basiq's connection ID
  institutionId     String // Basiq institution ID
  institutionName   String // Bank name (e.g., "Commonwealth Bank")
  institutionLogo   String? // Logo URL
  status            BasiqConnectionStatus @default(PENDING)
  lastSyncedAt      DateTime?
  lastSyncError     String?

  // Fix: G19 — CDR consent tracking fields (Basiq provides consent metadata)
  consentExpiresAt DateTime? // When CDR consent for this connection expires
  consentScope     String? // CDR data scope granted (e.g., "accounts,transactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId])
  @@index([status])
  @@index([consentExpiresAt])
  @@map("basiq_connections")
}

// =============================================================================
// CDR COMPLIANCE MODELS (Phase L — CDR Code-Level Remediation)
// =============================================================================

// Fix: G18 — Explicit CDR consent record for CDR Rules compliance.
// CDR requires tracking of informed, explicit consent with scope, duration, and legal basis.
model CDRConsent {
  id                String           @id @default(uuid())
  userId            String
  consentStatus     CDRConsentStatus @default(PENDING)
  scope             String[] // CDR data scopes granted (e.g., ["accounts", "transactions", "balances"])
  legalBasis        String? // Legal basis for data collection (e.g., "consumer_consent")
  grantedAt         DateTime?
  expiresAt         DateTime?
  revokedAt         DateTime?
  revokedReason     String?
  basiqConnectionId String? // Link to Basiq connection if applicable
  organizationId    String? // Link to org if consent is via organization
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consentStatus])
  @@index([expiresAt])
  @@map("cdr_consents")
}

enum CDRConsentStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  WITHDRAWN
}

// Fix: G43 — CDR complaint tracking model for CDR record-keeping requirements.
// CDR compliance requires tracking all consumer complaints about CDR data handling.
model CDRComplaint {
  id               String               @id @default(uuid())
  userId           String? // Complainant (null if external)
  complainantName  String?
  complainantEmail String?
  category         CDRComplaintCategory
  description      String
  status           CDRComplaintStatus   @default(OPEN)
  resolution       String?
  resolvedAt       DateTime?
  resolvedBy       String?
  escalatedToOAIC  Boolean              @default(false)
  oaicReferenceId  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // Relationships
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("cdr_complaints")
}

enum CDRComplaintCategory {
  DATA_ACCESS // Complaint about CDR data access
  DATA_DELETION // Complaint about CDR data not being deleted
  CONSENT_MANAGEMENT // Complaint about consent handling
  DATA_ACCURACY // Complaint about CDR data accuracy
  PRIVACY // General privacy complaint
  SERVICE // Service-related complaint
  OTHER
}

enum CDRComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED
  CLOSED
}

// Fix: G43 — CDR disclosure tracking model.
// CDR record-keeping requires logging all instances where CDR data was disclosed.
model CDRDisclosure {
  id             String            @id @default(uuid())
  userId         String
  disclosedTo    String // Entity CDR data was disclosed to
  disclosureType CDRDisclosureType
  dataScope      String[] // What CDR data was disclosed
  legalBasis     String // Legal basis for disclosure
  consentId      String? // Link to CDR consent if applicable
  createdAt      DateTime          @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("cdr_disclosures")
}

enum CDRDisclosureType {
  CONSUMER_REQUESTED // Consumer requested their data be shared
  REGULATORY // Required by regulation (e.g., OAIC request)
  LEGAL // Legal proceedings
  INTERNAL // Internal use within organization
}

// =============================================================================
// INCOME
// =============================================================================

model Income {
  id                  String           @id @default(uuid())
  userId              String
  ownerEntityId       String // Phase 41: which LegalEntity receives this income — backfilled to user's PERSONAL_NAME entity
  propertyId          String?
  investmentAccountId String?
  customCategoryId    String? // Custom user-defined category (overrides 'type' enum if set)
  name                String
  type                IncomeType       @default(OTHER) // System type (fallback when customCategoryId is null)
  sourceType          IncomeSourceType @default(GENERAL)
  amount              Float
  frequency           Frequency

  // Phase 20: Salary-specific fields (only applicable when type = SALARY)
  salaryType   SalaryType? // GROSS or NET (null for non-salary)
  payFrequency PayFrequency? // Pay cycle frequency

  // Phase 20: Calculated fields for salary
  grossAmount     Float? // If NET entered, calculated GROSS
  netAmount       Float? // If GROSS entered, calculated NET
  paygWithholding Float? // Calculated PAYG withholding (annual)

  // Phase 20: Superannuation (for SALARY type)
  superGuaranteeRate   Float? // e.g., 0.115 for 11.5%
  superGuaranteeAmount Float? // Calculated SG amount (annual)
  salarySacrifice      Float? // Pre-tax super sacrifice (annual)

  // Phase 20: Tax determination (auto-calculated, replaces isTaxable)
  taxCategory        TaxCategory? // System-determined category
  taxableAmount      Float? // The taxable portion
  taxExemptAmount    Float? // Any exempt portion
  frankingCredits    Float? // For dividends
  frankingPercentage Float? // Franking percentage (0-100)
  taxNotes           String? // Explanation of tax treatment

  // Legacy field - kept for backward compatibility, will be deprecated
  isTaxable Boolean @default(true)

  // Phase 30: Budget vs Actual Reconciliation
  budgetedAmount Float? // Original budgeted/estimated amount (preserved when actual updates)
  lastReconciled DateTime? // When amount was last updated from real transactions

  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relationships
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerEntity        LegalEntity         @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)
  property           Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  investmentAccount  InvestmentAccount?  @relation(fields: [investmentAccountId], references: [id], onDelete: SetNull)
  customCategory     Category?           @relation("IncomeCustomCategory", fields: [customCategoryId], references: [id], onDelete: SetNull)
  transactions       Transaction[]
  superContributions SuperContribution[]

  @@index([userId])
  @@index([ownerEntityId])
  @@index([propertyId])
  @@index([investmentAccountId])
  @@index([customCategoryId])
  @@map("income")
}

// =============================================================================
// EXPENSE
// =============================================================================

model Expense {
  id                  String            @id @default(uuid())
  userId              String
  ownerEntityId       String // Phase 41: which LegalEntity bears this expense — backfilled to user's PERSONAL_NAME entity
  propertyId          String?
  loanId              String?
  investmentAccountId String?
  assetId             String? // Phase 21: Link to asset
  customCategoryId    String? // Custom user-defined category (overrides 'category' enum if set)
  name                String
  vendorName          String?
  category            ExpenseCategory   @default(OTHER) // System category (fallback when customCategoryId is null)
  sourceType          ExpenseSourceType @default(GENERAL)
  amount              Float
  frequency           Frequency
  isEssential         Boolean           @default(true)
  isTaxDeductible     Boolean           @default(false)
  isRecurring         Boolean           @default(true) // Is this a recurring expense or one-off/discretionary?

  // Phase 30: Budget vs Actual Reconciliation
  budgetedAmount Float? // Original budgeted/estimated amount (preserved when actual updates)
  lastReconciled DateTime? // When amount was last updated from real transactions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerEntity       LegalEntity        @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)
  property          Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  loan              Loan?              @relation(fields: [loanId], references: [id], onDelete: SetNull)
  investmentAccount InvestmentAccount? @relation(fields: [investmentAccountId], references: [id], onDelete: SetNull)
  asset             Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  customCategory    Category?          @relation("ExpenseCustomCategory", fields: [customCategoryId], references: [id], onDelete: SetNull)
  transactions      Transaction[]

  // Phase 29: Linked recurring payments from bank detection
  linkedRecurringPayments RecurringPayment[] @relation("RecurringPaymentExpense")

  @@index([userId])
  @@index([ownerEntityId])
  @@index([propertyId])
  @@index([loanId])
  @@index([investmentAccountId])
  @@index([assetId])
  @@index([customCategoryId])
  @@map("expenses")
}

// =============================================================================
// TRANSACTION
// =============================================================================

model Transaction {
  id          String               @id @default(uuid())
  userId      String
  accountId   String
  propertyId  String?
  loanId      String?
  incomeId    String?
  expenseId   String?
  date        DateTime
  description String
  amount      Float
  direction   TransactionDirection
  category    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Relationships
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  income  Income?  @relation(fields: [incomeId], references: [id], onDelete: SetNull)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([accountId])
  @@index([date])
  @@map("transactions")
}

// =============================================================================
// DEBT PLAN (Optional storage of debt planner results)
// =============================================================================

model DebtPlan {
  id                 String       @id @default(uuid())
  userId             String
  name               String
  strategy           DebtStrategy
  surplusPerPeriod   Float
  surplusFrequency   Frequency
  emergencyBuffer    Float        @default(0)
  respectFixedCaps   Boolean      @default(true)
  rolloverRepayments Boolean      @default(true)
  totalInterestPaid  Float
  totalInterestSaved Float
  debtFreeDate       DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relationships
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanDetails DebtPlanLoan[]

  @@index([userId])
  @@map("debt_plans")
}

// =============================================================================
// DEBT PLAN LOAN (Per-loan results from debt planner)
// =============================================================================

model DebtPlanLoan {
  id                String   @id @default(uuid())
  debtPlanId        String
  loanId            String
  loanName          String
  originalPrincipal Float
  payoffDate        DateTime
  totalInterestPaid Float
  monthsSaved       Int
  interestSaved     Float
  createdAt         DateTime @default(now())

  // Relationships
  debtPlan DebtPlan @relation(fields: [debtPlanId], references: [id], onDelete: Cascade)
  loan     Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([debtPlanId])
  @@index([loanId])
  @@map("debt_plan_loans")
}

// =============================================================================
// PHASE 3: INVESTMENT ENUMS
// =============================================================================

enum InvestmentAccountType {
  BROKERAGE
  SUPERS
  FUND
  TRUST
  ETF_CRYPTO
}

enum HoldingType {
  SHARE
  ETF
  MANAGED_FUND
  CRYPTO
}

enum InvestmentTransactionType {
  BUY
  SELL
  DIVIDEND
  DISTRIBUTION
  DRP
  DEPOSIT // Cash deposit into account
  WITHDRAWAL // Cash withdrawal from account
  TRANSFER_IN // Assets transferred in (e.g., from another broker)
  TRANSFER_OUT // Assets transferred out
  CORPORATE_ACTION // Stock splits, mergers, etc.
}

// Phase 23: Capital Gains Tax Tracking
enum CostBasisMethod {
  FIFO // First In, First Out
  LIFO // Last In, First Out
  HIFO // Highest In, First Out (tax optimized)
  SPECIFIC // Specific identification
  AVERAGE // Average cost (for managed funds)
}

enum CapitalGainType {
  SHORT_TERM // Held < 12 months (no CGT discount)
  LONG_TERM // Held >= 12 months (50% CGT discount applies)
}

enum DepreciationCategory {
  DIV40
  DIV43
}

enum DepreciationMethod {
  PRIME_COST
  DIMINISHING_VALUE
}

// =============================================================================
// PHASE 21: ASSET MANAGEMENT ENUMS
// =============================================================================

enum AssetType {
  VEHICLE
  ELECTRONICS
  FURNITURE
  EQUIPMENT
  COLLECTIBLE
  OTHER
}

enum AssetStatus {
  ACTIVE // Currently owned
  SOLD // Sold/disposed
  WRITTEN_OFF // Written off (damaged/lost)
}

enum VehicleFuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  LPG
  OTHER
}

// =============================================================================
// PHASE 3: INVESTMENT ACCOUNT
// =============================================================================

model InvestmentAccount {
  id            String                @id @default(uuid())
  userId        String
  ownerEntityId String // Phase 41: which LegalEntity owns this investment account — backfilled to user's PERSONAL_NAME entity
  name          String
  type          InvestmentAccountType
  platform      String? // e.g. CommSec, SelfWealth, Betashares app
  currency      String                @default("AUD")

  // Phase 23: Balance tracking fields
  openingDate      DateTime?
  openingBalance   Float           @default(0)
  cashBalance      Float           @default(0)
  totalDeposits    Float           @default(0)
  totalWithdrawals Float           @default(0)
  costBasisMethod  CostBasisMethod @default(FIFO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerEntity  LegalEntity             @relation(fields: [ownerEntityId], references: [id], onDelete: Restrict)
  holdings     InvestmentHolding[]
  transactions InvestmentTransaction[]
  incomes      Income[]
  expenses     Expense[]
  capitalGains CapitalGainEvent[]

  @@index([userId])
  @@index([ownerEntityId])
  @@map("investment_accounts")
}

// =============================================================================
// PHASE 3: INVESTMENT HOLDING
// =============================================================================

model InvestmentHolding {
  id                  String      @id @default(uuid())
  investmentAccountId String
  ticker              String // VAS, A200, VGS, BHP
  name                String? // Full name (e.g., "Vanguard Australian Shares ETF")
  units               Float
  averagePrice        Float
  frankingPercentage  Float? // AU feature for franking credits
  type                HoldingType

  // Phase 23: Enhanced tracking
  firstPurchaseDate DateTime? // Date of first purchase (for CGT discount)
  totalCostBasis    Float     @default(0) // Total amount invested
  currentPrice      Float? // Latest market price per unit
  currentValue      Float? // units * currentPrice (computed on update)
  priceUpdatedAt    DateTime? // When price was last updated
  unrealizedGain    Float? // currentValue - totalCostBasis
  unrealizedGainPct Float? // Percentage gain/loss

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  investmentAccount InvestmentAccount       @relation(fields: [investmentAccountId], references: [id], onDelete: Cascade)
  transactions      InvestmentTransaction[]
  purchaseLots      PurchaseLot[]
  capitalGains      CapitalGainEvent[]

  @@index([investmentAccountId])
  @@index([ticker])
  @@map("investment_holdings")
}

// =============================================================================
// PHASE 3: INVESTMENT TRANSACTION
// =============================================================================

model InvestmentTransaction {
  id                  String                    @id @default(uuid())
  investmentAccountId String
  holdingId           String?
  date                DateTime
  type                InvestmentTransactionType
  price               Float
  units               Float
  fees                Float?
  notes               String?

  // Phase 23: Enhanced transaction tracking
  ticker       String? // For BUY/SELL when holdingId not yet created
  totalAmount  Float? // price * units + fees (for reporting)
  exchangeRate Float? // For foreign currency transactions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  investmentAccount InvestmentAccount  @relation(fields: [investmentAccountId], references: [id], onDelete: Cascade)
  holding           InvestmentHolding? @relation(fields: [holdingId], references: [id], onDelete: SetNull)
  purchaseLot       PurchaseLot? // Created when this is a BUY transaction
  capitalGainEvent  CapitalGainEvent? // Created when this is a SELL transaction

  @@index([investmentAccountId])
  @@index([holdingId])
  @@index([date])
  @@map("investment_transactions")
}

// =============================================================================
// PHASE 23: PURCHASE LOT (PARCEL) TRACKING FOR CGT
// =============================================================================

model PurchaseLot {
  id            String @id @default(uuid())
  holdingId     String
  transactionId String @unique

  // Lot details
  purchaseDate DateTime
  units        Float // Units in this lot
  unitCost     Float // Price per unit at purchase
  totalCost    Float // units * unitCost + fees
  fees         Float    @default(0)

  // Tracking
  unitsRemaining Float // Units not yet sold (starts = units)
  isFullySold    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  holding                InvestmentHolding          @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  transaction            InvestmentTransaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  capitalGainAllocations CapitalGainLotAllocation[]

  @@index([holdingId])
  @@index([purchaseDate])
  @@map("purchase_lots")
}

// =============================================================================
// PHASE 23: CAPITAL GAIN EVENT (REALIZED GAINS/LOSSES)
// =============================================================================

model CapitalGainEvent {
  id                  String @id @default(uuid())
  investmentAccountId String
  holdingId           String
  transactionId       String @unique

  // Sale details
  saleDate      DateTime
  unitsSold     Float
  salePrice     Float // Price per unit at sale
  saleFees      Float    @default(0)
  grossProceeds Float // unitsSold * salePrice - saleFees

  // Cost basis (calculated from allocated lots)
  totalCostBasis Float // Sum of cost from allocated purchase lots

  // Gain/Loss calculation
  capitalGain     Float // grossProceeds - totalCostBasis
  capitalGainType CapitalGainType // SHORT_TERM or LONG_TERM
  cgtDiscount     Float           @default(0) // 50% discount if LONG_TERM
  taxableGain     Float // capitalGain - cgtDiscount

  // Tax year tracking
  financialYear String // e.g., "2024-25"

  // Additional info
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  investmentAccount InvestmentAccount          @relation(fields: [investmentAccountId], references: [id], onDelete: Cascade)
  holding           InvestmentHolding          @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  transaction       InvestmentTransaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  lotAllocations    CapitalGainLotAllocation[]

  @@index([investmentAccountId])
  @@index([holdingId])
  @@index([financialYear])
  @@index([saleDate])
  @@map("capital_gain_events")
}

// =============================================================================
// PHASE 23: CAPITAL GAIN LOT ALLOCATION (WHICH LOTS WERE SOLD)
// =============================================================================

model CapitalGainLotAllocation {
  id                 String @id @default(uuid())
  capitalGainEventId String
  purchaseLotId      String

  // Allocation details
  unitsAllocated     Float // How many units from this lot were sold
  costBasisAllocated Float // Proportional cost basis
  holdingPeriodDays  Int // Days between purchase and sale

  createdAt DateTime @default(now())

  // Relationships
  capitalGainEvent CapitalGainEvent @relation(fields: [capitalGainEventId], references: [id], onDelete: Cascade)
  purchaseLot      PurchaseLot      @relation(fields: [purchaseLotId], references: [id], onDelete: Cascade)

  @@index([capitalGainEventId])
  @@index([purchaseLotId])
  @@map("capital_gain_lot_allocations")
}

// =============================================================================
// PHASE 3: DEPRECIATION SCHEDULE
// =============================================================================

model DepreciationSchedule {
  id         String               @id @default(uuid())
  propertyId String
  category   DepreciationCategory
  assetName  String
  cost       Float
  startDate  DateTime
  rate       Float // 2.5% for Div43, or effective life rate
  method     DepreciationMethod // PRIME_COST | DIMINISHING_VALUE
  notes      String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  // Relationships
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("depreciation_schedules")
}

// =============================================================================
// PHASE 10: ORGANIZATION & MULTI-TENANT
// =============================================================================

model Organization {
  id                   String           @id @default(uuid())
  name                 String
  slug                 String           @unique
  description          String?
  // Profession is the canonical "what kind of firm is this?" field. Drives the
  // Practice dashboard layout, alert library defaults, scope presets, and
  // AFSL/credit-licence guardrails. Must be chosen at registration (force; no
  // MULTI). Re-uses the existing `OrganizationType` enum so the legacy
  // `OrganizationPortalSettings.organizationType` becomes a shadow — see
  // `docs/IMPLEMENTATION_PLAN.md` 🗑️ Dead Code for the dedup follow-up.
  profession           OrganizationType @default(FINANCIAL_ADVISOR)
  mfaEnforced          Boolean          @default(false)
  sessionDurationHours Int              @default(168) // 7 days
  allowedDomains       String[] // Email domain restrictions
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  // Relationships
  members                 OrganizationMember[]
  auditLogs               AuditLog[]
  strategyRecommendations StrategyRecommendation[]
  professionalListing     ProfessionalListing?

  // Phase 33g: Adviser feedback threads can carry org context (so Reza can
  // filter the inbox by org). Set on creation to the adviser's currentOrg.
  feedbackThreads FeedbackThread[]

  // Phase 32C PR4d: conversations owned by this org (one per accepted
  // request, plus org-attached client conversations from ClientLink).
  conversations           ProfessionalConversation[]

  // Phase 32C PR6: Stripe billing — one customer record per Org once the
  // owner first enters the billing flow; subscription state mirrored from
  // Stripe webhooks. Test-mode at v1; live mode wires post-Basiq.
  stripeCustomer          StripeCustomer?
  stripeSubscription      StripeSubscription?

  @@map("organizations")
}

model OrganizationMember {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  role           UserRole  @default(VIEWER)
  invitedBy      String? // User ID who sent the invitation
  invitedAt      DateTime  @default(now())
  joinedAt       DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phase 32C PR4c: marketplace requests this member has responded to.
  respondedRequests ProfessionalRequest[]

  // Phase 32C PR4d: conversation participation as a professional-side seat.
  conversationParticipations ConversationParticipant[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

// =============================================================================
// PHASE 10: MFA & AUTHENTICATION
// =============================================================================

model MFAMethod {
  id          String    @id @default(uuid())
  userId      String
  type        MFAType
  isEnabled   Boolean   @default(true)
  isPrimary   Boolean   @default(false)
  secret      String? // For TOTP: encrypted secret
  phoneNumber String? // For SMS: phone number
  backupCodes String[] // Encrypted backup codes
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_methods")
}

model PasskeyCredential {
  id           String    @id @default(uuid())
  userId       String
  credentialId String    @unique // WebAuthn credential ID
  publicKey    String // Public key for verification
  counter      Int       @default(0)
  deviceName   String?
  transports   String[] // e.g., ["usb", "nfc", "ble"]
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

model UserSession {
  id                String   @id @default(uuid())
  userId            String
  token             String   @unique
  deviceName        String?
  deviceFingerprint String?
  ipAddress         String?
  userAgent         String?
  isActive          Boolean  @default(true)
  expiresAt         DateTime
  lastActivityAt    DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("user_sessions")
}

// =============================================================================
// PHASE 10: AUDIT LOGGING
// =============================================================================

model AuditLog {
  id             String      @id @default(uuid())
  userId         String?
  organizationId String?
  action         AuditAction
  status         AuditStatus @default(SUCCESS)
  entityType     String? // "Property", "Loan", "User", etc.
  entityId       String? // ID of the affected entity
  ipAddress      String?
  userAgent      String?
  metadata       Json? // Additional context (old/new values, error details)
  createdAt      DateTime    @default(now())

  // Relationships
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =============================================================================
// PHASE 10: MAGIC LINK AUTHENTICATION
// =============================================================================

model MagicLink {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  email      String
  expiresAt  DateTime
  usedAt     DateTime?
  redirectTo String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  // Relationships
