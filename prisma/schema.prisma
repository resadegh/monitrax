// =============================================================================
// PHASE 29: AI TRANSACTION CATEGORISATION & LEARNING
// =============================================================================

enum AILearningSource {
  AI_PREDICTION // Original AI prediction
  USER_CORRECTION // User corrected the AI prediction
  USER_CONFIRMED // User confirmed AI prediction was correct
  RULE_MATCH // Matched by categorisation rule
  BASIQ_ENRICHED // Enriched by BASIQ data
}

enum ImportReviewStatus {
  PENDING // Awaiting user review
  AUTO_ACCEPTED // High confidence, auto-accepted
  USER_CONFIRMED // User confirmed categorisation
  USER_EDITED // User edited categorisation
  SKIPPED // User skipped/dismissed
}

model AICategorizationLearning {
  id            String @id @default(uuid())
  userId        String
  transactionId String @unique

  // Original AI prediction
  aiCategoryLevel1 String?
  aiCategoryLevel2 String?
  aiSubcategory    String?
  aiConfidence     Float // Original AI confidence (0-1)
  aiIsEssential    Boolean @default(false)
  aiIsRecurring    Boolean @default(false)
  aiReasoning      String? @db.Text

  // Final (user-confirmed or corrected) values
  finalCategoryLevel1 String?
  finalCategoryLevel2 String?
  finalSubcategory    String?
  finalIsEssential    Boolean @default(false)
  finalIsRecurring    Boolean @default(false)

  // Learning metadata
  wasEdited               Boolean          @default(false)
  source                  AILearningSource @default(AI_PREDICTION)
  appliedToSimilar        Boolean          @default(false) // Applied to other similar transactions
  similarTransactionCount Int              @default(0) // How many similar transactions updated

  // Merchant learning context
  merchantRaw          String?
  merchantStandardised String?
  amountRange          String? // e.g., "0-50", "50-100", "100-500"

  // Timestamps
  predictionAt DateTime  @default(now())
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  user User @relation("AICategorizationLearnings", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([merchantStandardised])
  @@index([aiCategoryLevel1])
  @@index([source])
  @@index([wasEdited])
  @@map("ai_categorization_learnings")
}

model AILearningPattern {
  id     String  @id @default(uuid())
  userId String? // Null = global pattern, set = user-specific

  // Pattern identification
  patternType  String // MERCHANT, AMOUNT_RANGE, DESCRIPTION_KEYWORD, TIME_OF_DAY, DAY_OF_WEEK
  patternValue String // The pattern value (merchant name, keyword, amount range)
  patternHash  String // Hash for quick lookup

  // Learned categorisation
  categoryLevel1     String
  categoryLevel2     String?
  subcategory        String?
  isEssential        Boolean @default(false)
  isRecurring        Boolean @default(false)
  suggestedFrequency String? // WEEKLY, FORTNIGHTLY, MONTHLY, etc.

  // Learning strength (increases with each confirmation)
  confidence      Float @default(0.5) // Confidence in this pattern (0-1)
  matchCount      Int   @default(1) // Times this pattern matched
  confirmCount    Int   @default(0) // Times user confirmed
  correctionCount Int   @default(0) // Times user corrected

  // Context
  averageAmount Float?
  minAmount     Float?
  maxAmount     Float?

  // Timestamps
  lastMatchAt     DateTime  @default(now())
  lastConfirmedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, patternType, patternHash])
  @@index([userId])
  @@index([patternType])
  @@index([patternHash])
  @@index([confidence])
  @@map("ai_learning_patterns")
}

model ImportBatch {
  id        String @id @default(uuid())
  userId    String
  accountId String

  // Source information
  source   TransactionSource @default(MANUAL)
  fileName String?
  fileHash String? // SHA256 hash for deduplication
  fileSize Int?

  // Date range of transactions in this batch
  dateRangeStart DateTime
  dateRangeEnd   DateTime

  // Statistics
  totalTransactions Int @default(0)
  importedCount     Int @default(0)
  duplicatesSkipped Int @default(0)
  duplicatesMerged  Int @default(0)
  errorCount        Int @default(0)

  // AI categorisation stats
  aiCategorisedCount Int @default(0)
  autoAcceptedCount  Int @default(0)
  needsReviewCount   Int @default(0)
  userConfirmedCount Int @default(0)
  userEditedCount    Int @default(0)

  // Processing status
  status                ImportStatus @default(PENDING)
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  errorMessage          String?      @db.Text

  // Balance information
  openingBalance      Float?
  closingBalance      Float?
  balanceUpdated      Boolean   @default(false)
  userVerifiedBalance Float? // Balance verified by user after import
  balanceVerifiedAt   DateTime? // When user verified the balance

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user        User                     @relation("ImportBatches", fields: [userId], references: [id], onDelete: Cascade)
  account     Account                  @relation("ImportBatches", fields: [accountId], references: [id], onDelete: Cascade)
  reviewQueue TransactionReviewQueue[]

  @@index([userId])
  @@index([accountId])
  @@index([status])
  @@index([dateRangeStart, dateRangeEnd])
  @@index([fileHash])
  @@map("import_batches")
}

model TransactionReviewQueue {
  id            String  @id @default(uuid())
  userId        String
  importBatchId String?
  transactionId String? // Set after transaction is created

  // Transaction data (before creation)
  tempData Json // Stores transaction data before confirmed

  // AI Prediction
  aiCategoryLevel1 String?
  aiCategoryLevel2 String?
  aiSubcategory    String?
  aiConfidence     Float   @default(0)
  aiIsEssential    Boolean @default(false)
  aiIsRecurring    Boolean @default(false)
  aiReasoning      String?

  // Confidence classification
  confidenceLevel String @default("MANUAL") // AUTO_ACCEPT, NEEDS_REVIEW, MANUAL

  // Review status
  status ImportReviewStatus @default(PENDING)

  // User edits (if any)
  userCategoryLevel1 String?
  userCategoryLevel2 String?
  userSubcategory    String?
  userIsEssential    Boolean?
  userIsRecurring    Boolean?

  // Apply to similar
  applyToSimilar         Boolean @default(false)
  similarMerchantPattern String? // Pattern to match similar transactions

  // Duplicate detection
  isDuplicate     Boolean @default(false)
  duplicateOf     String? // ID of duplicate transaction
  duplicateAction String? // SKIP, MERGE, IMPORT_ANYWAY

  // Timestamps
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  updatedAt  DateTime  @updatedAt

  // Relationships
  user        User         @relation("TransactionReviewQueue", fields: [userId], references: [id], onDelete: Cascade)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([importBatchId])
  @@index([status])
  @@index([confidenceLevel])
  @@map("transaction_review_queue")
}

// User settings for AI categorisation
model UserCategorizationSettings {
  id     String @id @default(uuid())
  userId String @unique

  // Confidence thresholds
  autoAcceptThreshold Float @default(0.90) // >= 90% auto-accept
  reviewThreshold     Float @default(0.70) // >= 70% show for review

  // AI behaviour
  enableAI               Boolean @default(true)
  learnFromConfirmations Boolean @default(true)
  applyLearningsGlobally Boolean @default(false) // Apply learnings to all users (admin only)

  // Review preferences
  showConfidenceScores  Boolean @default(true)
  showAIReasoning       Boolean @default(true)
  defaultApplyToSimilar Boolean @default(true)

  // Notification preferences
  notifyOnPendingReview  Boolean @default(true)
  pendingReviewThreshold Int     @default(10) // Notify when X transactions pending

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_categorization_settings")
}

// =============================================================================
// PHASE 38 PR 3 — SHARE PASS (My Vault accountant-share + generic share engine)
// =============================================================================
//
// Generic, polymorphic share-link engine. v1 wires the DOCUMENT_BUNDLE
// content-type for "Send to accountant" from My Vault. The same machinery
// (token, expiry, audit, revocation, recipient tracking) is reused as we
// add new content types (Reports, property summaries, net-worth statements,
// tax positions). Future delivery methods (Xero / MYOB direct push) extend
// the deliveryMethod enum without a schema migration.
//
// Reza directives (2026-05-01):
//   • Option C (secure share-link) for v1; Option E (direct accountant-
//     software push) parked as future expansion.
//   • Default expiry 30 days.
//   • Recipient page: minimal share-only aesthetic (no app shell).
//
// CDR alignment: every state transition (CREATE / READ / EXPORT / DELETE)
// is logged via createAuditLog() with entityType='SharePackage' so we have
// a full chain-of-custody trail for any data shared externally
// (CLAUDE.md §13.5).
// =============================================================================

model SharePackage {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Public access — opaque URL-safe token (≥32 chars, generated server-side).
  // The token IS the auth — no PII in the URL, no enumerable IDs.
  token String @unique

  // Recipient (optional — accountant name + email for owner's own records;
  // not required to create a share).
  recipientName  String?
  recipientEmail String?

  // Why this share exists. Drives sensible defaults in the modal +
  // appropriate copy on the recipient page.
  purpose SharePackagePurpose

  // Polymorphic content reference. Shape varies by contentType:
  //   DOCUMENT_BUNDLE → { documentIds: string[], structure: 'financial-year-first' | 'entity-first' | 'category-first' }
  //   (Future) REPORT → { reportType: string, periodStart: ISO, periodEnd: ISO }
  //   (Future) NET_WORTH_SNAPSHOT → { snapshotId: string }
  // The recipient page reads this + dispatches to the right renderer.
  contentType  SharePackageContentType
  contentRefs  Json
  contentLabel String? // human-readable, e.g. "FY 2024–25 documents"

  // Delivery transport. v1 supports LINK + DOWNLOAD_ONLY. Future v2+ adds
  // EMAIL_LINK, XERO_PUSH, MYOB_PUSH without a schema migration — the
  // enum extends, the share row pattern stays the same.
  deliveryMethod SharePackageDeliveryMethod @default(LINK)

  // Lifecycle
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?

  // Tracking — visible on the owner's Manage Shares page so they can
  // see their share is being used (or not) without external tooling.
  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  // Watermark text rendered on the recipient page footer + (future) on
  // ZIP contents. Auto-generated server-side if null:
  // "Generated from Monitrax · {FY label} · {owner name}".
  watermarkText String?

  // Owner's private notes — not shown to recipient.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@index([expiresAt, revokedAt])
}

enum SharePackagePurpose {
  TAX_RETURN
  LOAN_APPLICATION
  INSURANCE_CLAIM
  ADVISER_REVIEW
  OTHER
}

enum SharePackageContentType {
  DOCUMENT_BUNDLE
  // Future: REPORT, PROPERTY_SUMMARY, NET_WORTH_SNAPSHOT, TAX_POSITION
}

enum SharePackageDeliveryMethod {
  LINK // shareable URL with token (default)
  EMAIL_LINK // app emails the link to recipientEmail on creation
  DOWNLOAD_ONLY // owner downloads ZIP locally; no public token issued
  // Future: XERO_PUSH, MYOB_PUSH
}

// =============================================================================
// Phase 40 — My Guide AI Financial Advice
//
// `AIAdviceDocument` is the canonical persisted output of the AI advisor for a
// given user. Cached with a 24h TTL (`expiresAt`) to cap Gemini Pro spend and
// because the underlying snapshot doesn't change minute-to-minute.
// `fingerprint` is a stable hash of the snapshot inputs that drove the advice
// — when those inputs change materially (new transactions imported, balances
// updated, properties added/removed), the fingerprint changes and a fresh
// advice doc is generated on next request.
//
// CDR alignment per CLAUDE.md §13.3: the `document` JSON contains aggregates
// + AI-generated narrative ONLY. No account numbers, BSBs, transaction-level
// descriptions, or payee names are ever written here. The advisor service
// sanitises the snapshot before sending to Gemini AND before persisting.
//
// `AIAdviceChatMessage` holds follow-up Q&A scoped to a specific advice doc.
// Cascade-deletes with the advice doc, so chat lifetime = advice cache lifetime.
// =============================================================================

model AIAdviceDocument {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stable hash of the snapshot inputs (net worth, cashflow, debt, properties,
  // emergency fund, health score, etc.). When this changes, a fresh advice
  // doc is generated on next request. See `lib/cfo/aiAdvisor.ts:fingerprintSnapshot`.
  fingerprint String

  // The user's TRAIL stage at the time of generation — drives stage-aware
  // prompt context and ranks recommendations.
  trailStage String // T | R | A | I | L

  // Full structured advice document. Shape defined by `AIAdviceDocument`
  // TypeScript interface in lib/cfo/aiAdvisor.ts. Stored as Json so the
  // shape can evolve without a migration.
  document Json

  // Telemetry — kept for cost/quality observability.
  modelUsed     String?
  tokensUsed    Int?
  estimatedCost Float?

  // True when Gemini failed and we returned the rule-engine fallback advice.
  isFallback Boolean @default(false)

  // 24h TTL. A nightly job (or a lazy check on read) evicts expired docs.
  expiresAt DateTime
  createdAt DateTime @default(now())

  chatMessages AIAdviceChatMessage[]

  @@index([userId, expiresAt])
  @@index([userId, fingerprint])
}

model AIAdviceChatMessage {
  id        String           @id @default(uuid())
  adviceId  String
  advice    AIAdviceDocument @relation(fields: [adviceId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant" | "system"
  content   String           @db.Text
  createdAt DateTime         @default(now())

  @@index([adviceId, createdAt])
}

// =============================================================================
// PHASE 32C PR4a: PROFESSIONAL MARKETPLACE
// =============================================================================
// Org-attached users see only their org's roster; D2C users (no org link) see
// the public marketplace. Listings are invite-only at v1 — every listing must
// be APPROVED by a Monitrax admin before it appears publicly. The admin queue
// at `/admin/marketplace/listings` is where AFSL / credit-rep / TPB numbers
// are manually cross-checked against ASIC + TPB public registers; automated
// API cross-check defers to PROD (see IMPLEMENTATION_PLAN.md DEFERRED bucket).
// One listing per Org at v1; multi-discipline firms collapse to a single
// listing with multiple `specialisations` rather than parallel listings.

model ProfessionalListing {
  id             String       @id @default(uuid())
  organizationId String       @unique // one listing per org at v1
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Public identity
  publicSlug   String  @unique // URL slug at /marketplace/<slug>
  displayName  String // can differ from Organization.name
  tagline      String? @db.VarChar(140) // 140-char hook
  blurb        String? @db.Text // longer pitch (~2000 chars)
  heroImageUrl String? // placeholder for now (Cloud Storage URL post-MVP)

  // Discipline + facets
  discipline      OrganizationType // FINANCIAL_ADVISOR / MORTGAGE_BROKER / ACCOUNTING_FIRM / TAX_AGENT / BOOKKEEPER / OTHER
  specialisations ProfessionalSpecialisation[]
  targetTiers     ListingTargetTier[]
  regions         ListingRegion[]

  // Compliance numbers (verified during admin approval)
  afslNumber      String? // for FINANCIAL_ADVISOR
  creditRepNumber String? // for MORTGAGE_BROKER (NCCP credit rep)
  tpbNumber       String? // for TAX_AGENT / ACCOUNTING_FIRM (Tax Practitioners Board)
  abn             String? // for cross-check via abr.business.gov.au

  // Lead-fee tier (resolved at listing-approval; tiered by user net-worth bracket)
  leadFeeTierEmerging    Decimal @default(80) @db.Decimal(8, 2) // AU$ <$200k user
  leadFeeTierGrowing     Decimal @default(150) @db.Decimal(8, 2) // AU$ $200k-$1M user
  leadFeeTierEstablished Decimal @default(250) @db.Decimal(8, 2) // AU$ $1M+ user

  // Approval workflow
  status            ListingStatus @default(DRAFT)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  reviewedByAdmin   AdminUser?    @relation("AdminReviewedListings", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  rejectionReason   String?       @db.Text

  // Verification record (manual at v1; automated ASIC/TPB API cross-check post-launch)
  verificationNotes  String?   @db.Text // admin's notes from manual cross-check
  asicCrossCheckedAt DateTime?
  tpbCrossCheckedAt  DateTime?

  // Stats (denormalised for browse-page performance — refreshed by service writes)
  ratingsCount          Int      @default(0)
  averageRating         Decimal? @db.Decimal(3, 2) // 0.00..5.00
  acceptedRequestsCount Int      @default(0) // lifetime accepted ProfessionalRequests

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ratings  ProfessionalRating[]
  requests ProfessionalRequest[]

  @@index([status])
  @@index([discipline, status])
  @@index([publicSlug])
  @@map("professional_listings")
}

model ProfessionalRating {
  id        String              @id @default(uuid())
  listingId String
  listing   ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Rater identity (Phase 32C PR4c will gate this on a completed
  // ProfessionalRequest engagement — at v1 no enforcement, schema is ready).
  raterUserId String
  rater       User   @relation(fields: [raterUserId], references: [id], onDelete: Cascade)

  stars   Int // 1..5
  comment String? @db.Text

  // Moderation (admin can flag a rating off the public surface without deleting)
  isPublic      Boolean   @default(true)
  flaggedAt     DateTime?
  flaggedReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, raterUserId]) // one rating per user per listing
  @@index([listingId])
  @@map("professional_ratings")
}

enum ListingStatus {
  DRAFT // Org is filling out the listing
  PENDING_REVIEW // Submitted, waiting for admin approval
  APPROVED // Live on public marketplace
  REJECTED // Admin rejected — Org can revise + resubmit
  SUSPENDED // Was approved, admin pulled it (compliance issue, etc.)
}

enum ProfessionalSpecialisation {
  // Adviser-leaning
  RETIREMENT_PLANNING
  WEALTH_BUILDING
  TAX_OPTIMISATION
  ESTATE_PLANNING
  RISK_INSURANCE
  // Broker-leaning
  HOME_LOANS
  INVESTMENT_LOANS
  REFINANCE
  COMMERCIAL_LENDING
  FIRST_HOME_BUYER
  // Accountant / tax-leaning
  PERSONAL_TAX
  SMALL_BUSINESS
  TRUST_ACCOUNTING
  SMSF_ACCOUNTING
  PROPERTY_INVESTORS
}

enum ListingTargetTier {
  EMERGING // <$200k net wealth
  GROWING // $200k-$1M
  ESTABLISHED // $1M-$3M
  HIGH_NET_WORTH // $3M+
}

enum ListingRegion {
  NSW_SYDNEY_METRO
  NSW_REGIONAL
  VIC_MELBOURNE_METRO
  VIC_REGIONAL
  QLD_BRISBANE_METRO
  QLD_REGIONAL
  WA
  SA
  TAS
  ACT
  NT
  NATIONAL
}

// =============================================================================
// PHASE 32C PR4c: PROFESSIONAL REQUEST LIFECYCLE
// =============================================================================
// D2C user picks a marketplace listing → composes a question → submits →
// adviser inbox → ACCEPTED (lead fee billing intent recorded) / DECLINED.
// On ACCEPTED, an OrganizationClient row is created so the engagement
// materialises (consent invite path).
//
// Lead-fee tier is resolved at SUBMIT time from the user's net worth via
// `masterFinancialService.ts` (Emerging <$200k / Growing $200k–$1M /
// Established $1M+). The amount is taken from the listing's per-tier rate
// at submit-time so changing tier rates after the fact doesn't affect
// already-submitted requests.
//
// Actual Stripe billing wires in PR6 — at v1 we record the charge intent
// (`leadFeeChargedAt` set on accept) without performing a live charge.
// CLAUDE.md §0 architect lens: keep the data model right; payment plumbing
// is a separate concern with its own deploy gate.

model ProfessionalRequest {
  id                  String              @id @default(uuid())

  // Who's asking
  requesterUserId     String
  requester           User                @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)

  // What they're asking about
  listingId           String
  listing             ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // The ask
  contextLabel        String? // tax / refinance / etc — how the user got here (open-ended; matches askAProfessionalService context vocabulary)
  question            String              @db.Text

  // Snapshot context shared at submission time (json snapshot of headline
  // metrics the user explicitly chose to share). NEVER includes raw account
  // numbers / transactions — only aggregated metrics (e.g. monthlyCashflow,
  // totalDebt, netWorthBracket). CDR sanitisation runs at the service layer.
  snapshotContextJson Json?

  // Lifecycle
  status              RequestStatus       @default(SUBMITTED)
  submittedAt         DateTime            @default(now())
  respondedAt         DateTime?
  respondedByMemberId String?
  respondedByMember   OrganizationMember? @relation(fields: [respondedByMemberId], references: [id], onDelete: SetNull)
  declineReason       String?             @db.Text
  withdrawnAt         DateTime?

  // Lead fee (resolved at submit-time, billed at accept-time; actual Stripe
  // charge wires in PR6 — at v1 `leadFeeChargedAt` is the billing intent)
  leadFeeTier         LeadFeeTier?
  leadFeeAmount       Decimal?            @db.Decimal(10, 2)
  leadFeeChargedAt    DateTime?

  // Engagement created if accepted — links to the OrganizationClient row
  // that materialises the relationship after consent. NULL until accept.
  clientLinkId        String?             @unique

  // Phase 32C PR4d: conversation auto-created on ACCEPT. NULL until
  // accepted; one-to-one once it materialises.
  conversation        ProfessionalConversation?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([requesterUserId, status])
  @@index([listingId, status])
  @@index([status, submittedAt])
  @@map("professional_requests")
}

enum RequestStatus {
  SUBMITTED   // User submitted; awaiting adviser action
  ACCEPTED    // Adviser accepted; lead fee billing intent recorded; ClientLink created
  DECLINED    // Adviser declined; no fee charged, no link created
  WITHDRAWN   // User withdrew before adviser action
  EXPIRED     // 14+ days no adviser response; auto-marked by scheduled job
}

enum LeadFeeTier {
  EMERGING    // <$200k net worth — listing.leadFeeTierEmerging applies
  GROWING     // $200k-$1M net worth — listing.leadFeeTierGrowing applies
  ESTABLISHED // $1M+ net worth — listing.leadFeeTierEstablished applies
}

// =============================================================================
// PHASE 33g: ADVISER FEEDBACK INBOX
// =============================================================================
//
// Async feedback channel for post-pitch + pilot advisers. Adviser writes a
// thread from /portal/feedback (or via the help-drawer footer link); Reza
// reads + replies + flips status from /admin/feedback. A weekly Markdown
// export endpoint feeds a Claude Code session for theme synthesis.
//
// Design doc: docs/blueprint/PHASE_33G_ADVISER_FEEDBACK_INBOX.md
//
// Architecture note (CLAUDE.md §12.2 SSOT): these are deliberately SEPARATE
// from Phase 32C PR4d's ProfessionalConversation model — different
// participants (Monitrax↔adviser vs adviser↔client), different retention
// rules (24mo default vs 7yr archive), different status workflow (bug-tracker
// shape vs message-only). Forcing them through one schema would require a
// discriminator nightmare. Do NOT consolidate without revisiting that
// rationale; logged in IMPLEMENTATION_PLAN.md Open Questions.

enum FeedbackSurfaceTag {
  BUG // Something that should work but doesn't
  FEATURE // Wishlist / enhancement
  UX // Friction / clarity / labelling concern
  PRAISE // Positive signal — capture for testimonials + roadmap validation
  QUESTION // Genuine question (we point them at the help article + improve discoverability)
  COMPLIANCE // CDR / AFSL / TPB / privacy concern — auto-flagged for 7yr retention
}

enum FeedbackSeverity {
  LOW
  MEDIUM
  HIGH
}

enum FeedbackStatus {
  OPEN // Just submitted; awaiting first admin response
  IN_REVIEW // Admin has replied / triaged
  PLANNED // On the roadmap (linked to an Up Next entry, ideally)
  SHIPPED // Resolved — fix is live
  WONT_FIX // Out of scope; closed with reasoning
  DUPLICATE // Closed; pointed at the canonical thread
}

enum FeedbackAuthorRole {
  ADVISER
  MONITRAX_ADMIN
}

model FeedbackThread {
  id             String             @id @default(uuid())
  userId         String // Adviser who submitted the thread
  organizationId String? // Org context if the adviser is org-attached
  subject        String             @db.VarChar(140)
  surfaceRoute   String? // e.g. "/portal/clients/abc/view" — auto-filled from caller pathname
  surfaceTag     FeedbackSurfaceTag
  severity       FeedbackSeverity   @default(MEDIUM)
  status         FeedbackStatus     @default(OPEN)
  // Reza-only — never returned to adviser-facing API. Excluded from the
  // Markdown export by default; can be opted-in for Claude synthesis.
  internalNotes  String?            @db.Text
  // When true, this thread (and its messages) are included in the Markdown
  // export Reza pipes into a Claude Code session for theme synthesis.
  taggedForAi    Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  // Set by /admin/feedback whenever an admin views or replies. Used by the
  // 48h SLA cron (queued post-MVP) to flag OPEN threads with no admin attention.
  lastReviewedAt DateTime?

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  messages     FeedbackMessage[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@map("feedback_threads")
}

model FeedbackMessage {
  id         String             @id @default(uuid())
  threadId   String
  authorId   String // FK to User — author may be the adviser OR a Monitrax admin
  authorRole FeedbackAuthorRole
  body       String             @db.Text // markdown source; rendered via lib/help/markdown.ts
  createdAt  DateTime           @default(now())

  thread FeedbackThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([authorId])
  @@map("feedback_messages")
}

// =============================================================================
// PHASE 32C PR4d: IN-APP CONVERSATIONS + EMAIL-THROUGH-APP
// =============================================================================
// One conversation per ACCEPTED ProfessionalRequest engagement. Both sides
// post messages in the in-app thread; outbound email mirrors via SendGrid;
// inbound email replies route via SendGrid Inbound Parse webhook. The
// adviser's compliance archive retains every message for 7 years
// (decision 2026-05-04 — "transcript retention model = soft-delete from
// user view + 7yr retention for the professional's compliance archive,
// with explicit disclosure at consent time").
//
// `replyToSlug` is the per-conversation reply-to address fragment so
// inbound webhooks can route messages back to the right thread without
// requiring database scans on the From header. Format:
//   monitrax+conv-<replyToSlug>@<inbound-domain>
// PROD hardening (DKIM/SPF strict mode, Cloud DLP attachment scanning,
// rate-limiting, HTML→plaintext sanitisation) defers to PROD per
// IMPLEMENTATION_PLAN.md DEFERRED bucket.

model ProfessionalConversation {
  id              String  @id @default(uuid())

  // Origin — every conversation traces back to either an accepted public
  // marketplace request OR an org-attached client link (org-side roster
  // path from AskAPro picker, ships in this PR). Exactly one is set.
  requestId       String? @unique
  request         ProfessionalRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  // Org context (always set — required for inbox scoping + audit)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Public reply-to slug — used by SendGrid Inbound Parse to route email
  // replies back to this thread. UUID-prefixed to keep it unguessable.
  replyToSlug     String   @unique

  // Subject — pre-populated from the ProfessionalRequest question (first
  // 80 chars), editable by the professional after accept.
  subject         String   @db.VarChar(160)

  // Lifecycle metadata
  isClosed        Boolean  @default(false)  // Either party can close; closed = read-only
  closedAt        DateTime?
  closedByUserId  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastMessageAt   DateTime @default(now())

  participants    ConversationParticipant[]
  messages        ConversationMessage[]

  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([replyToSlug])
  @@map("professional_conversations")
}

model ConversationParticipant {
  id              String  @id @default(uuid())

  conversationId  String
  conversation    ProfessionalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // The participant — exactly one of userId or memberId is set:
  //   - userId    → consumer-side (User)
  //   - memberId  → professional-side (OrganizationMember)
  userId          String?
  user            User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId        String?
  member          OrganizationMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  role            ConversationRole

  // Soft-delete from user view — does NOT remove the row (compliance
  // archive must persist 7yr). Hides from this participant's surface only.
  hiddenFromUser  Boolean  @default(false)
  hiddenAt        DateTime?

  // Read-receipt tracking — used for unread badge count. Updated when the
  // participant fetches messages with `markAsRead: true`.
  lastReadAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([conversationId, userId, memberId])
  @@index([conversationId])
  @@index([userId])
  @@index([memberId])
  @@map("conversation_participants")
}

enum ConversationRole {
  CONSUMER       // The user who submitted the request (or org-attached client)
  PROFESSIONAL   // OrganizationMember on the org side
  AI_HELPER      // Reserved for Phase 33g (AI-suggested replies); not used at PR4d
}

model ConversationMessage {
  id              String  @id @default(uuid())

  conversationId  String
  conversation    ProfessionalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Sender — always a User (the OrganizationMember.user for professional
  // side; the participant.user for consumer side; null for system messages
  // which are reserved for future use).
  senderUserId    String?
  sender          User? @relation("ConversationMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  // Sender role at the time the message was sent (frozen — even if the
  // person leaves the org later, the audit trail says "sent as PROFESSIONAL").
  senderRole      ConversationRole

  // Message content (plain-text only at v1; rich-text and attachments
  // defer to PROD per DEFERRED bucket).
  body            String  @db.Text

  // Channel — was this composed in-app or bridged in/out via email?
  channel         MessageChannel @default(IN_APP)
  // Outbound email: SendGrid message ID (for delivery tracking)
  externalMessageId String?
  // Inbound email: original From header + raw subject for audit
  inboundFromEmail String?
  inboundSubject   String?

  // 7-yr retention for the professional's compliance archive. Soft-delete
  // from user view does NOT change this column — the row persists until
  // retentionUntil passes, at which point a scheduled job (PROD) sweeps it.
  retentionUntil  DateTime

  createdAt       DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([retentionUntil])
  @@map("conversation_messages")
}

enum MessageChannel {
  IN_APP        // Composed in the in-app thread
  EMAIL_OUT     // Outbound — sent via SendGrid mirroring an in-app message
  EMAIL_IN      // Inbound — received via SendGrid Inbound Parse webhook
  SYSTEM        // Reserved (welcome message on conversation creation, etc.)
}

// =============================================================================
// PHASE 32C PR6: STRIPE BILLING (TEST-MODE)
// =============================================================================
// One StripeCustomer per Org (lazy-created when the owner first enters the
// billing flow). One StripeSubscription per Org reflects the live state of
// the org's plan. StripeWebhookEvent records every webhook event we
// process so we can dedupe (Stripe may deliver the same event multiple
// times) and audit (the events table is the source of truth for "what
// did Stripe tell us happened").
//
// At v1 we run test-mode only — the keys are TEST_STRIPE_SECRET_KEY +
// TEST_STRIPE_PUBLISHABLE_KEY + TEST_STRIPE_WEBHOOK_SECRET. Live mode
// wires post-Basiq accreditation per IMPLEMENTATION_PLAN.md DEFERRED.
//
// `planTier` on StripeSubscription is the canonical PlanTier (STUDIO /
// PRACTICE / ENTERPRISE) — the legacy `OrganizationPortalSettings.plan`
// (STARTER/PROFESSIONAL/BUSINESS/ENTERPRISE) is a shadow that the planTier
// service maps from. Enum rename is queued for a follow-up migration.

model StripeCustomer {
  id                String  @id @default(uuid())
  organizationId    String  @unique
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stripeCustomerId  String  @unique  // cus_xxx from Stripe
  // The portal-owner email at customer-creation time. Stripe can also
  // hold an email; this column is just for fast lookup without round-tripping.
  email             String

  // True when this customer was created in Stripe TEST mode. Once we go
  // live (post-Basiq), new customers will be `false`. The webhook handler
  // routes to the right keyspace based on this flag.
  isTestMode        Boolean @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscription      StripeSubscription?

  @@index([stripeCustomerId])
  @@map("stripe_customers")
}

model StripeSubscription {
  id                     String   @id @default(uuid())
  organizationId         String   @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId             String   @unique  // FK to StripeCustomer.id
  customer               StripeCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  stripeSubscriptionId   String   @unique  // sub_xxx from Stripe
  status                 SubscriptionStatus  // mirrors Stripe's status enum

  // Plan tier the user is subscribed to — canonical PlanTier vocabulary.
  planTier               BillingPlanTier

  // Stripe-side identifiers used to look up the price + product when we
  // need to upgrade/downgrade. Stored verbatim from the webhook event so
  // we don't re-fetch from Stripe to find them.
  stripePriceId          String
  stripeProductId        String

  // Billing period info — surfaced in the org's billing surface.
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean  @default(false)

  // Test-mode flag mirrors the customer.
  isTestMode             Boolean  @default(true)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([stripeSubscriptionId])
  @@index([status])
  @@map("stripe_subscriptions")
}

model StripeWebhookEvent {
  id                String   @id @default(uuid())
  // Stripe's event id (evt_xxx) — unique constraint lets the handler
  // dedupe if Stripe re-delivers the same event.
  stripeEventId     String   @unique
  eventType         String   // customer.subscription.created / invoice.paid / etc
  livemode          Boolean  // false in test mode

  // The full event payload — kept for audit + debugging. Trimmed to
  // metadata only on PROD if storage becomes a concern (Stripe events
  // can be retrieved by id from their API for 30 days).
  payload           Json

  // Processing outcome — written when the handler completes.
  processedAt       DateTime?
  processingError   String?  @db.Text

  receivedAt        DateTime @default(now())

  @@index([eventType])
  @@index([receivedAt])
  @@map("stripe_webhook_events")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum BillingPlanTier {
  STUDIO        // AU$199/mo — 3 seats, 50 clients
  PRACTICE      // AU$599/mo — 10 seats, 250 clients
  ENTERPRISE    // From AU$1,499/mo — custom seats + clients
}
