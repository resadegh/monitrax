{
  "name": "monitrax",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "npm run lint:financial-surfaces && npm run neomatrix:check && prisma migrate deploy && prisma generate && npm run seed:feature-flags && next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:financial-surfaces": "npx ts-node --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' scripts/lint-financial-surfaces.ts",
    "postinstall": "prisma generate",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:validation": "npm run seed:validation && vitest run --reporter=verbose",
    "test:regression": "vitest run tests/regression",
    "test:sanity": "vitest run tests/sanity",
    "test:calculations": "vitest run tests/calculations",
    "seed:validation": "npx ts-node prisma/seed-validation.ts",
    "seed:admin": "npx ts-node prisma/seed-admin.ts",
    "seed:lighthouse": "npx ts-node prisma/seed-lighthouse.ts",
    "seed:portal-access": "npx ts-node prisma/seed-portal-test-access.ts",
    "seed:feature-flags": "npx ts-node --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' prisma/seed-feature-flags.ts",
    "validate": "npm run seed:validation && npm run test && npm run generate:report",
    "generate:report": "npx ts-node tests/validation/generate-report.ts",
    "neomatrix:generate": "node scripts/neomatrix/generate-financial-logic.mjs",
    "neomatrix:check": "node scripts/neomatrix/generate-financial-logic.mjs --check && node scripts/neomatrix/check-layer0-coverage.mjs && node scripts/neomatrix/check-binding-coverage.mjs && node scripts/neomatrix/check-census.mjs",
    "neomatrix:graphify": "node scripts/neomatrix/graphify-layer0.mjs",
    "neomatrix:coverage": "node scripts/neomatrix/reconcile-registry.mjs",
    "neomatrix:census": "node scripts/neomatrix/calc-census.mjs",
    "neomatrix:proven": "node scripts/neomatrix/generate-proven-set.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@dagrejs/dagre": "^3.0.0",
    "@google-cloud/cloud-sql-connector": "^1.10.0",
    "@google-cloud/error-reporting": "^3.0.5",
    "@google-cloud/logging": "^11.2.1",
    "@google-cloud/monitoring": "^5.3.2",
    "@google-cloud/scheduler": "^5.3.2",
    "@google-cloud/security-center": "^9.3.1",
    "@google-cloud/storage": "^7.18.0",
    "@google-cloud/vision": "^5.3.6",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/functions": "^3.5.0",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "framer-motion": "^12.38.0",
    "google-auth-library": "^10.6.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.553.0",
    "next": "15.5.19",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.15.0",
    "pg": "^8.20.0",
    "postcss": "^8",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-3d": "^1.29.1",
    "recharts": "^3.5.0",
    "stripe": "^22.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^5.10.7",
    "typescript": "^5",
    "unpdf": "^1.4.0",
    "uuid": "^9.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.19",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "vitest": "^1.6.1"
  }
}
